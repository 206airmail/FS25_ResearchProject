                                            <xs:enumeration value="DIFFERENTIAL_SPEED" />
                                            <xs:enumeration value="SPEED" />
                                            <xs:enumeration value="SUSPENSION" />
                                            <xs:enumeration value="COMBINE_LOAD" />
                                            <xs:enumeration value="DRIVING_DIRECTION" />
