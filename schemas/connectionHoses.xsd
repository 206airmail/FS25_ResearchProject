                                                </xs:attribute>
                                                <xs:attribute name="materialTemplateName" type="fs25_materialTemplate">
                                                    <xs:annotation><xs:documentation xml:lang="en">Material template to be applied by default</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="name" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Name of material</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="uvLengthScale" type="g_float" default="1">
                                                    <xs:annotation><xs:documentation xml:lang="en">Scale factor of the UV in X axis</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="uvMinMax" type="g_vector_2">
                                                    <xs:annotation><xs:documentation xml:lang="en">Min. and max. range of uv&apos;s in Y</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="uvRandomOffset" type="g_vector_2" default="0 0">
