                                                <xs:attribute name="useStateChange" type="g_bool" default="false">
                                                    <xs:annotation><xs:documentation xml:lang="en">Dashboard is active for a defined amount of time when the source value changes</xs:documentation></xs:annotation>
                                                </xs:attribute>
