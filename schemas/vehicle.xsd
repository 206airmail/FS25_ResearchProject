                                                            </xs:attribute>
                                                            <xs:attribute name="value" type="g_bool" default="true">
                                                                <xs:annotation><xs:documentation xml:lang="en">Worker is allowed the turn backward with this tool</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                        </xs:complexType>
                                                    </xs:element>
                                                    <xs:element name="areaMarkers" minOccurs="0" maxOccurs="1">
                                                        <xs:complexType>
                                                            <xs:attribute name="backNode" type="g_node_index">
                                                                <xs:annotation><xs:documentation xml:lang="en">AI area back node</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="leftNode" type="g_node_index">
                                                                <xs:annotation><xs:documentation xml:lang="en">AI area left node</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="rightNode" type="g_node_index">
                                                                <xs:annotation><xs:documentation xml:lang="en">AI area right node</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="sideOffset" type="g_float" default="0">
                                                                <xs:annotation><xs:documentation xml:lang="en">Side offset of the ai markers to the center of the leading vehicle</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="sideOffsetHeadlandAlternate" type="g_bool" default="false">
                                                                <xs:annotation><xs:documentation xml:lang="en">Alternate the side offset during headland work</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="validityOffset" type="g_float" default="0">
                                                                <xs:annotation><xs:documentation xml:lang="en">Side offset on the validity checks of the segments</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="width" type="g_float">
                                                                <xs:annotation><xs:documentation xml:lang="en">Working width of the ai implement</xs:documentation><xs:appinfo><defaultStr>automatically calculated based on distance between ai markers while activating the ai</defaultStr></xs:appinfo></xs:annotation>
                                                            </xs:attribute>
                                                        </xs:complexType>
                                                    </xs:element>
                                                    <xs:element name="attacherJoint" type="AttacherJoint" minOccurs="0" maxOccurs="unbounded"/>
                                                    <xs:element name="blockTurnBackward" minOccurs="0" maxOccurs="1">
                                                        <xs:complexType>
                                                            <xs:attribute name="value" type="g_bool" default="false">
                                                                <xs:annotation><xs:documentation xml:lang="en">Can be used for non ai tools to block ai from driving backward</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                        </xs:complexType>
                                                    </xs:element>
                                                    <xs:element name="collisionTrigger" minOccurs="0" maxOccurs="1">
                                                        <xs:complexType>
                                                            <xs:attribute name="backNode" type="g_node_index">
                                                                <xs:annotation><xs:documentation xml:lang="en">Collision trigger node while driving backwards (Z-Axis pointing backwards)</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="height" type="g_float" default="3">
                                                                <xs:annotation><xs:documentation xml:lang="en">Width of ai collision trigger</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="length" type="g_float" default="5">
                                                                <xs:annotation><xs:documentation xml:lang="en">Max. length of ai collision trigger</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="node" type="g_node_index">
                                                                <xs:annotation><xs:documentation xml:lang="en">Collision trigger node</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="useSize" type="g_bool" default="false">
                                                                <xs:annotation><xs:documentation xml:lang="en">Use vehicle size box to calculate the ai collision box (will be placed in front of it)</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="width" type="g_float" default="4">
                                                                <xs:annotation><xs:documentation xml:lang="en">Width of ai collision trigger</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                        </xs:complexType>
                                                    </xs:element>
                                                    <xs:element name="component" type="VehicleConfigurationDataAdditionalMass" minOccurs="0" maxOccurs="unbounded"/>
                                                    <xs:element name="dependentConfiguration" minOccurs="0" maxOccurs="unbounded">
                                                        <xs:complexType>
                                                            <xs:attribute name="index" type="g_int">
                                                                <xs:annotation><xs:documentation xml:lang="en">Index of the configuration to use</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="name" type="g_string">
                                                                <xs:annotation><xs:documentation xml:lang="en">Name of the other configuration to set</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                        </xs:complexType>
                                                    </xs:element>
                                                    <xs:element name="foliageBendingModifier" type="foliageBendingModifier" minOccurs="0" maxOccurs="unbounded"/>
                                                    <xs:element name="hasNoFullCoverageArea" minOccurs="0" maxOccurs="1">
                                                        <xs:complexType>
                                                            <xs:attribute name="offset" type="g_float" default="0">
                                                                <xs:annotation><xs:documentation xml:lang="en">Non full coverage area offset</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="value" type="g_bool" default="false">
                                                                <xs:annotation><xs:documentation xml:lang="en">Tool as a no full coverage area (e.g. plows)</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                        </xs:complexType>
                                                    </xs:element>
