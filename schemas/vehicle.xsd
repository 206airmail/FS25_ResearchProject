                                            </xs:complexType>
                                        </xs:element>
                                    </xs:choice>
                                </xs:complexType>
                            </xs:element>
                        </xs:choice>
                    </xs:complexType>
                </xs:element>
                <xs:element name="configurationSets" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:choice maxOccurs="unbounded">
                            <xs:element name="configurationSet" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:choice maxOccurs="unbounded">
                                        <xs:element name="configuration" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="index" type="g_int">
                                                    <xs:annotation><xs:documentation xml:lang="en">Selected index</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="name" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Configuration name</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="showWarning" type="g_bool" default="true">
                                                    <xs:annotation><xs:documentation xml:lang="en">Show warning if config is not available (e.g. config that is added via a mod like Precision Farming)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:choice>
                                    <xs:attribute name="isDefault" type="g_bool">
                                        <xs:annotation><xs:documentation xml:lang="en">Is default set</xs:documentation></xs:annotation>
