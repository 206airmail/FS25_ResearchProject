                                                    <xs:annotation><xs:documentation xml:lang="en">(TEXT) Global X scale of text</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="textScaleY" type="g_float" default="1">
                                                    <xs:annotation><xs:documentation xml:lang="en">(TEXT) Global Y scale of text</xs:documentation></xs:annotation>
