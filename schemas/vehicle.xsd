                                                            <xs:enumeration value="cruiseControlReverse" />
                                                            <xs:enumeration value="directionForward" />
                                                            <xs:enumeration value="directionBackward" />
                                                            <xs:enumeration value="movingDirection" />
                                                            <xs:enumeration value="cruiseControlActive" />
                                                            <xs:enumeration value="accelerationAxis" />
                                                            <xs:enumeration value="decelerationAxis" />
                                                            <xs:enumeration value="ac_decelerationAxis" />
                                                            <xs:enumeration value="steeringAngle" />
                                                            <xs:enumeration value="combinedPedalLeft" />
                                                            <xs:enumeration value="combinedPedalRight" />
                                                            <xs:enumeration value="odometerMilage" />
