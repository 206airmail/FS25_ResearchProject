                                    </xs:attribute>
                                    <xs:attribute name="lengthOffset" type="g_float">
                                        <xs:annotation><xs:documentation xml:lang="en">AI vehicle length offset</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="maxBrakeAcceleration" type="g_float">
                                        <xs:annotation><xs:documentation xml:lang="en">AI vehicle max brake acceleration</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="maxCentripetalAcceleration" type="g_float">
                                        <xs:annotation><xs:documentation xml:lang="en">AI vehicle max centripetal acceleration</xs:documentation></xs:annotation>
                                    </xs:attribute>
