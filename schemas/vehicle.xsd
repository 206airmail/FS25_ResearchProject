                        <xs:annotation><xs:documentation xml:lang="en">Index of the component joint to influence</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="transDampingFactor" type="g_float">
                        <xs:annotation><xs:documentation xml:lang="en">Factor that is applied to the trans damping of the component joint</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="transSpringFactor" type="g_float">
