                                    <xs:attribute name="outdoorRotation" type="g_angle" default="0">
                                        <xs:annotation><xs:documentation xml:lang="en">Steering wheel outdoor rotation</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:all>
