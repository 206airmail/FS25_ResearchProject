                                                        <xs:annotation><xs:documentation xml:lang="en">Display type name</xs:documentation></xs:annotation>
                                                        <xs:restriction base="xs:string">
                                                            <xs:enumeration value="TRANS" />
                                                            <xs:enumeration value="ROT" />
                                                            <xs:enumeration value="SLIDER" />
                                                            <xs:enumeration value="VISIBILITY" />
                                                            <xs:enumeration value="TEXT" />
                                                            <xs:enumeration value="MULTI_STATE" />
                                                            <xs:enumeration value="EMITTER" />
                                                            <xs:enumeration value="NUMBER" />
                                                            <xs:enumeration value="ANIMATION" />
                                                        </xs:restriction>
                                                    </xs:simpleType>
                                                </xs:attribute>
                                                <xs:attribute name="doInterpolation" type="g_bool" default="false">
                                                    <xs:annotation><xs:documentation xml:lang="en">Do interpolation</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="emissiveScale" type="g_float" default="0.2">
                                                    <xs:annotation><xs:documentation xml:lang="en">(NUMBER) Scale of emissive map</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="emitColor" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">(EMITTER) Emit color (DashboardColor OR BrandColor OR r g b a)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="excludedLightTypes" type="g_vector_n">
                                                    <xs:annotation><xs:documentation xml:lang="en">Excluded light types</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="fillType" type="fs25_fillType">
                                                    <xs:annotation><xs:documentation xml:lang="en">Fill type of fillUnit to be used</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="fillUnitIndex" type="g_int">
                                                    <xs:annotation><xs:documentation xml:lang="en">Fill unit index to represent</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="font" type="g_string" default="DIGIT">
                                                    <xs:annotation><xs:documentation xml:lang="en">(NUMBER) Name of font to apply to mesh</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="fontThickness" type="g_float" default="1">
                                                    <xs:annotation><xs:documentation xml:lang="en">(TEXT) Thickness factor for font characters</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="groups" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">List of groups</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="hasNormalMap" type="g_bool" default="false">
                                                    <xs:annotation><xs:documentation xml:lang="en">(NUMBER) Normal map will be applied to number decals</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="hiddenColor" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">(TEXT) Color of hidden character (if defined a &apos;0&apos; in this color is display instead of nothing)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="hideInactive" type="g_bool" default="false">
                                                    <xs:annotation><xs:documentation xml:lang="en">(EMITTER) Hide the emitter shape when the dashboard is inactive</xs:documentation></xs:annotation>
