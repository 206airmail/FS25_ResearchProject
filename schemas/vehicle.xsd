                                                </xs:attribute>
                                                <xs:attribute name="hiddenColor" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">(TEXT) Color of hidden character (if defined a &apos;0&apos; in this color is display instead of nothing)</xs:documentation></xs:annotation>
