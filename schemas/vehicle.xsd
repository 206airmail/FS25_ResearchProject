                                                    <xs:annotation><xs:documentation xml:lang="en">Is selected by default in shop config screen</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="isSelectable" type="g_bool" default="true">
                                                    <xs:annotation><xs:documentation xml:lang="en">Configuration can be selected in the shop</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="name" type="g_l10n_string">
