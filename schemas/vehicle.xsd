                                    <xs:attribute name="width" type="g_float" default="3">
                                        <xs:annotation><xs:documentation xml:lang="en">Agent attachable width</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="aiConfigurations" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:choice maxOccurs="unbounded">
                                        <xs:element name="aiConfiguration" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:choice maxOccurs="unbounded">
                                                    <xs:element name="aiAgent" type="configAIAgent" minOccurs="0" maxOccurs="1"/>
