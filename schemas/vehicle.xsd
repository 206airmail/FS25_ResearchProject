                                                                <xs:annotation><xs:documentation xml:lang="en">Size area back node</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="leftNode" type="g_node_index">
                                                                <xs:annotation><xs:documentation xml:lang="en">Size area left node</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="rightNode" type="g_node_index">
                                                                <xs:annotation><xs:documentation xml:lang="en">Size area right node</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                        </xs:complexType>
