                                </xs:complexType>
                            </xs:element>
                            <xs:element name="speedRotScale" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="offset" type="g_float" default="0.7">
                                        <xs:annotation><xs:documentation xml:lang="en">Speed dependent steering speed offset</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="scale" type="g_float" default="80">
