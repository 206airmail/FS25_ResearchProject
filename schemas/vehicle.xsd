            <xs:element name="trigger" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                    <xs:attribute name="node" type="g_node_index">
                        <xs:annotation><xs:documentation xml:lang="en">Player activation trigger</xs:documentation></xs:annotation>
