                                                    <xs:annotation><xs:documentation xml:lang="en">Configuration can be selected in the shop</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="name" type="g_l10n_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Configuration name</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="params" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Extra parameters to insert in #name text</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="price" type="g_float" default="0">
                                                    <xs:annotation><xs:documentation xml:lang="en">Price of configuration</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="requiresEasyArmControl" type="g_bool" default="true">
                                                    <xs:annotation><xs:documentation xml:lang="en">If &apos;true&apos; then it is only available if easy arm control is enabled</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="returnPositionNode" type="g_node_index">
                                                    <xs:annotation><xs:documentation xml:lang="en">This node is used as target if no tree to align has been found (only for platforms with automatic vehicle control)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="saveId" type="g_string" default="Number of configuration">
                                                    <xs:annotation><xs:documentation xml:lang="en">Custom save id</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="typeDesc" type="g_l10n_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Type description text to display in shop while config is active</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="vehicleBrand" type="fs25_brand">
                                                    <xs:annotation><xs:documentation xml:lang="en">Custom brand to display after bought with this configuration</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="vehicleIcon" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Custom icon to display after bought with this configuration</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="vehicleName" type="g_l10n_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Custom vehicle name to display after bought with this configuration</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="workingWidth" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">Work width to display in shop while config is active</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:choice>
                                    <xs:attribute name="isYesNoOption" type="g_bool" default="false">
                                        <xs:annotation><xs:documentation xml:lang="en">UI in the shop will just show a yes/no slider element</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="postLoadObjectChange" type="g_bool" default="false">
                                        <xs:annotation><xs:documentation xml:lang="en">Defines if the object changes are applied before or after post load (can be helpful if you manipulate wheel nodes, which is only possible before postLoad)</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="title" type="g_l10n_string">
                                        <xs:annotation><xs:documentation xml:lang="en">configuration title to display in shop</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="treeDetectionNode" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="cutHeight" type="g_float" default="0.4">
                                        <xs:annotation><xs:documentation xml:lang="en">Tree cur height measured from terrain height</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="maxAngle" type="g_angle" default="45">
                                        <xs:annotation><xs:documentation xml:lang="en">Max. angle to the target tree</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="maxRadius" type="g_float" default="10">
                                        <xs:annotation><xs:documentation xml:lang="en">Max. distance to tree</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="minRadius" type="g_float" default="5">
                                        <xs:annotation><xs:documentation xml:lang="en">Min. distance to tree</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="node" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">Tree detection node</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="treeMarker" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="color" type="g_color" default="0 2 0">
                                        <xs:annotation><xs:documentation xml:lang="en">Marker emissive color</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="filename" type="g_string" default="$data/shared/forestry/targetTreeMarker.i3d">
                                        <xs:annotation><xs:documentation xml:lang="en">Path to tree marker file</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="offset" type="g_float" default="0.01">
                                        <xs:annotation><xs:documentation xml:lang="en">Marker offset from tree</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="targetColor" type="g_color" default="2 2 0">
                                        <xs:annotation><xs:documentation xml:lang="en">Color if tree is available to alignment, but not ready for cut yet</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="tooThickColor" type="g_color" default="2 0 0">
                                        <xs:annotation><xs:documentation xml:lang="en">Color if tree is too thick to be cut</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="treeOffset" type="g_float" default="0.025">
                                        <xs:annotation><xs:documentation xml:lang="en">Offset from tree to marker</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="width" type="g_float" default="0.05">
                                        <xs:annotation><xs:documentation xml:lang="en">Marker width</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="xAlignment" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="movingToolNode" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">Moving tool to do alignment on X axis (most likely Y-Rot tool)</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="offset" type="g_float">
                                        <xs:annotation><xs:documentation xml:lang="en">X alignment offset from tree detection node</xs:documentation><xs:appinfo><defaultStr>Automatically calculated with the difference on X between xAlignment and zAlignment node</defaultStr></xs:appinfo></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="referenceNode" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">Reference node which should be at the top pivot point of the cutter</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="speedScale" type="g_float" default="1">
                                        <xs:annotation><xs:documentation xml:lang="en">Speed scale used to control the moving tool</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="threshold" type="g_angle" default="1">
                                        <xs:annotation><xs:documentation xml:lang="en">X alignment angle threshold (if angle to target is below this value the Y and Z alignment will start)</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="yAlignment" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="movingToolNode" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">Moving tool to do alignment on Y axis (EasyArmControl Y Target)</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="referenceNode" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">Reference node which is tried to be moved right in front of the tree</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="speedScale" type="g_float" default="1">
                                        <xs:annotation><xs:documentation xml:lang="en">Speed scale used to control the moving tool</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="zAlignment" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="moveBackDistance" type="g_float" default="2">
                                        <xs:annotation><xs:documentation xml:lang="en">Distance the arm is moved back behind the tree first to start the x alignment</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="movingToolNode" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">Moving tool to do alignment on Z axis (EasyArmControl Z Target)</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="referenceNode" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">Reference node which is tried to be moved right in front of the tree</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="speedScale" type="g_float" default="1">
                                        <xs:annotation><xs:documentation xml:lang="en">Speed scale used to control the moving tool</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:choice>
                        <xs:attribute name="foldMaxLimit" type="g_float" default="1">
                            <xs:annotation><xs:documentation xml:lang="en">Max. folding time to activate the automatic control</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="foldMinLimit" type="g_float" default="0">
                            <xs:annotation><xs:documentation xml:lang="en">Min. folding time to activate the automatic control</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="requiresEasyArmControl" type="g_bool" default="true">
                            <xs:annotation><xs:documentation xml:lang="en">If &apos;true&apos; then it is only available if easy arm control is enabled</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="returnPositionNode" type="g_node_index">
                            <xs:annotation><xs:documentation xml:lang="en">This node is used as target if no tree to align has been found (only for platforms with automatic vehicle control)</xs:documentation></xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="baleCounter" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:all>
                            <xs:element name="dashboards" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:choice maxOccurs="unbounded">
                                        <xs:element name="dashboard" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:choice maxOccurs="unbounded">
                                                    <xs:element name="state" minOccurs="0" maxOccurs="unbounded">
                                                        <xs:complexType>
                                                            <xs:attribute name="emitColor" type="g_string">
