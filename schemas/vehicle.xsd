                                        <xs:annotation><xs:documentation xml:lang="en">Spacing between crosses</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="yOffset" type="g_float" default="2">
                                        <xs:annotation><xs:documentation xml:lang="en">Y offset from water surface</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="waterEffects" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:choice maxOccurs="unbounded">
                                        <xs:element name="effectNode" type="EffectNode" minOccurs="0" maxOccurs="unbounded"/>
                                    </xs:choice>
                                    <xs:attribute name="minSpeed" type="g_float" default="5">
                                        <xs:annotation><xs:documentation xml:lang="en">Min. speed to enable the water effects</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:all>
                    </xs:complexType>
                </xs:element>
                <xs:element name="bunkerSiloCompacter" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:all>
                            <xs:element name="sounds" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:all>
                                        <xs:element name="compacting" type="SoundManager_sound" minOccurs="0" maxOccurs="1"/>
                                        <xs:element name="rolling" type="SoundManager_sound" minOccurs="0" maxOccurs="1"/>
                                    </xs:all>
                                </xs:complexType>
                            </xs:element>
                        </xs:all>
                        <xs:attribute name="compactingScale" type="g_float" default="1">
                            <xs:annotation><xs:documentation xml:lang="en">Compacting scale</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="turnedOnCompactingScale" type="g_float">
                            <xs:annotation><xs:documentation xml:lang="en">Compacting scale which is used while vehicle is turned on</xs:documentation><xs:appinfo><defaultStr>normal scale</defaultStr></xs:appinfo></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="useSpeedLimit" type="g_bool" default="false">
                            <xs:annotation><xs:documentation xml:lang="en">Defines if speed limit is used while compactor has contact with ground</xs:documentation></xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="cctDrivable" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:attribute name="cctHeight" type="g_float" default="1">
                            <xs:annotation><xs:documentation xml:lang="en">CCT height</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="cctRadius" type="g_float" default="1">
                            <xs:annotation><xs:documentation xml:lang="en">CCT radius</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="cctSlopeLimit" type="g_float" default="25">
                            <xs:annotation><xs:documentation xml:lang="en">CCT slope limit</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="cctStepOffset" type="g_float" default="0.35">
                            <xs:annotation><xs:documentation xml:lang="en">CCT step offset</xs:documentation></xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="chainRollers" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:choice maxOccurs="unbounded">
                            <xs:element name="chainRoller" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:choice maxOccurs="unbounded">
                                        <xs:element name="splineNode" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="node" type="g_node_index">
                                                    <xs:annotation><xs:documentation xml:lang="en">Regular transform group(s) that define the spline (at least two have to be defined)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:choice>
                                    <xs:attribute name="elementsNode" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">Root node that contains every chain link</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="endReferenceNode" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">Reference node for the alignment of the last chain link</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:choice>
                        <xs:attribute name="maxUpdateDistance" type="g_float" default="100">
                            <xs:annotation><xs:documentation xml:lang="en">If the player is more than this distance away the nodes will no longer be updated</xs:documentation></xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="combine" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:all>
                            <xs:element name="additives" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="fillTypes" type="fs25_fillTypeList" default="CHAFF GRASS_WINDROW">
                                        <xs:annotation><xs:documentation xml:lang="en">Fill types to apply additives</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="fillUnitIndex" type="g_int">
                                        <xs:annotation><xs:documentation xml:lang="en">Additives fill unit index</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="usage" type="g_float" default="2">
                                        <xs:annotation><xs:documentation xml:lang="en">Usage per picked up liter</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="animationNodes" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:choice maxOccurs="unbounded">
                                        <xs:element name="animationNode" type="AnimationNode" minOccurs="0" maxOccurs="unbounded"/>
                                    </xs:choice>
                                    <xs:attribute name="speedReverseFillLevel" type="g_float">
                                        <xs:annotation><xs:documentation xml:lang="en">If fill level is above the animation nodes will be reversed (Percent 0-1)</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="automaticTilt" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:choice maxOccurs="unbounded">
                                        <xs:element name="automaticTiltNode" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="dependentAnimation" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Animation that is updated depending on tilt state</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxAngle" type="g_angle" default="5">
                                                    <xs:annotation><xs:documentation xml:lang="en">Max. angle</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxSpeed" type="g_angle" default="2">
                                                    <xs:annotation><xs:documentation xml:lang="en">Max. angle change per second</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="minAngle" type="g_angle" default="-5">
                                                    <xs:annotation><xs:documentation xml:lang="en">Min. angle</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="node" type="g_node_index">
                                                    <xs:annotation><xs:documentation xml:lang="en">Automatic tilt node</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="updateAttacherJoint" type="g_bool">
                                                    <xs:annotation><xs:documentation xml:lang="en">Update cutter attacher joint</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:choice>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="buffer" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="fillUnitIndex" type="g_int">
                                        <xs:annotation><xs:documentation xml:lang="en">Buffer fill unit index (This fill unit will be filled first until it&apos;s full. Will be emptied if stopped to harvest)</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="loadingDelay" type="g_time" default="0">
                                        <xs:annotation><xs:documentation xml:lang="en">Time until the crops from the cutter are added to the tank</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="unloadingDelay" type="g_time">
                                        <xs:annotation><xs:documentation xml:lang="en">Time until the crops are not longer added to the tank after the cutting has been stopped</xs:documentation><xs:appinfo><defaultStr>same as #loadingDelay</defaultStr></xs:appinfo></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="unloadingTime" type="g_time" default="0">
                                        <xs:annotation><xs:documentation xml:lang="en">Buffer unloading speed</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="chopper" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="animName" type="g_string">
                                        <xs:annotation><xs:documentation xml:lang="en">Chopper toggle animation name</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="animSpeedScale" type="g_float" default="1">
                                        <xs:annotation><xs:documentation xml:lang="en">Chopper toggle animation speed</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="available" type="g_bool" default="false">
                                        <xs:annotation><xs:documentation xml:lang="en">Chopper is available</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="isPowered" type="g_bool" default="true">
                                        <xs:annotation><xs:documentation xml:lang="en">Vehicle needs to be powered to switch chopper</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="workAreaIndex" type="g_int">
                                        <xs:annotation><xs:documentation xml:lang="en">Chopper work area index</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="chopperAnimationNodes" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:choice maxOccurs="unbounded">
                                        <xs:element name="animationNode" type="AnimationNode" minOccurs="0" maxOccurs="unbounded"/>
                                    </xs:choice>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="chopperEffect" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:choice maxOccurs="unbounded">
                                        <xs:element name="effectNode" type="EffectNode" minOccurs="0" maxOccurs="unbounded"/>
                                    </xs:choice>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="dashboards" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:choice maxOccurs="unbounded">
                                        <xs:element name="dashboard" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:choice maxOccurs="unbounded">
                                                    <xs:element name="state" minOccurs="0" maxOccurs="unbounded">
                                                        <xs:complexType>
                                                            <xs:attribute name="emitColor" type="g_string">
                                                                <xs:annotation><xs:documentation xml:lang="en">(MULTI_STATE) Emit color if the node is a emitter</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="intensity" type="g_float">
                                                                <xs:annotation><xs:documentation xml:lang="en">(MULTI_STATE) Intensity if the node is a emitter</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="rotation" type="g_vector_rot">
                                                                <xs:annotation><xs:documentation xml:lang="en">(MULTI_STATE) Rotation while state is active</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="scale" type="g_vector_scale">
                                                                <xs:annotation><xs:documentation xml:lang="en">(MULTI_STATE) Scale while state is active</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="translation" type="g_vector_trans">
                                                                <xs:annotation><xs:documentation xml:lang="en">(MULTI_STATE) Translation while state is active</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="value" type="g_vector_n">
                                                                <xs:annotation><xs:documentation xml:lang="en">(MULTI_STATE) One or multiple values separated by space to activate the state</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="visibility" type="g_bool">
                                                                <xs:annotation><xs:documentation xml:lang="en">(MULTI_STATE) Visibility while state is active</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                        </xs:complexType>
                                                    </xs:element>
                                                    <xs:element name="valueMapping" minOccurs="0" maxOccurs="unbounded">
                                                        <xs:complexType>
                                                            <xs:attribute name="dashboardValue" type="g_float">
                                                                <xs:annotation><xs:documentation xml:lang="en">Value to be used for dashboard at this source value</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="sourceValue" type="g_float">
                                                                <xs:annotation><xs:documentation xml:lang="en">Source value</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:choice>
                                                <xs:attribute name="animName" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">(ANIMATION) Animation name</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="attacherJointNode" type="g_node_index">
                                                    <xs:annotation><xs:documentation xml:lang="en">Node of the attacher joint to use</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="attacherJointNodes" type="g_node_indices">
                                                    <xs:annotation><xs:documentation xml:lang="en">List of attacher joint indices to use (first active one is used)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="baseColor" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">(EMITTER) Base color (DashboardColor OR BrandColor OR r g b a)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="conditionalAnimationName" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Name of conditional animation</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="conditionalAnimationRange" type="g_vector_2">
                                                    <xs:annotation><xs:documentation xml:lang="en">Range of the conditional animation value</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="conditionGroupInverted" type="g_bool">
                                                    <xs:annotation><xs:documentation xml:lang="en">Invert the state of the condition group for the dashboard</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="conditionGroupName" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Name of the condition group</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="conditionStateName" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Name of condition state</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="disabledColor" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">(EMITTER) Disabled emit color (DashboardColor OR BrandColor OR r g b a)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="disabledIntensity" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">(EMITTER) Intensity while the dashboard group is not active</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="displayType">
                                                    <xs:simpleType>
                                                        <xs:annotation><xs:documentation xml:lang="en">Display type name</xs:documentation></xs:annotation>
                                                        <xs:restriction base="xs:string">
                                                            <xs:enumeration value="TRANS" />
                                                            <xs:enumeration value="ROT" />
                                                            <xs:enumeration value="SLIDER" />
                                                            <xs:enumeration value="VISIBILITY" />
                                                            <xs:enumeration value="TEXT" />
                                                            <xs:enumeration value="MULTI_STATE" />
                                                            <xs:enumeration value="EMITTER" />
                                                            <xs:enumeration value="NUMBER" />
                                                            <xs:enumeration value="ANIMATION" />
                                                        </xs:restriction>
                                                    </xs:simpleType>
                                                </xs:attribute>
                                                <xs:attribute name="doInterpolation" type="g_bool" default="false">
                                                    <xs:annotation><xs:documentation xml:lang="en">Do interpolation</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="emissiveScale" type="g_float" default="0.2">
                                                    <xs:annotation><xs:documentation xml:lang="en">(NUMBER) Scale of emissive map</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="emitColor" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">(EMITTER) Emit color (DashboardColor OR BrandColor OR r g b a)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="excludedLightTypes" type="g_vector_n">
                                                    <xs:annotation><xs:documentation xml:lang="en">Excluded light types</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="fillType" type="fs25_fillType">
                                                    <xs:annotation><xs:documentation xml:lang="en">Fill type of fillUnit to be used</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="fillUnitIndex" type="g_int">
                                                    <xs:annotation><xs:documentation xml:lang="en">Fill unit index to represent</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="font" type="g_string" default="DIGIT">
                                                    <xs:annotation><xs:documentation xml:lang="en">(NUMBER) Name of font to apply to mesh</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="fontThickness" type="g_float" default="1">
                                                    <xs:annotation><xs:documentation xml:lang="en">(TEXT) Thickness factor for font characters</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="groups" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">List of groups</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="hasNormalMap" type="g_bool" default="false">
                                                    <xs:annotation><xs:documentation xml:lang="en">(NUMBER) Normal map will be applied to number decals</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="hiddenColor" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">(TEXT) Color of hidden character (if defined a &apos;0&apos; in this color is display instead of nothing)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="hideInactive" type="g_bool" default="false">
                                                    <xs:annotation><xs:documentation xml:lang="en">(EMITTER) Hide the emitter shape when the dashboard is inactive</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="hideInactiveChildren" type="g_bool" default="false">
                                                    <xs:annotation><xs:documentation xml:lang="en">(EMITTER) Hide all the children when the dashboard is inactive</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="idleValue" type="g_float" default="0">
                                                    <xs:annotation><xs:documentation xml:lang="en">Idle value</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="inactiveColor" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">(EMITTER) Inactive emit color (DashboardColor OR BrandColor OR r g b a)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="inactiveGroups" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">(EMITTER) If defined, the inactive color/intensity will only be set if this group is active (if not active, the disabled color/intensity is used)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="inactiveIntensity" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">(EMITTER) Intensity while the dashboard state is not active, but the group is active</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="intensity" type="g_float" default="1">
                                                    <xs:annotation><xs:documentation xml:lang="en">Intensity</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="interpolationSpeed" type="g_float" default="0.005">
                                                    <xs:annotation><xs:documentation xml:lang="en">Interpolation speed</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="inverted" type="g_bool" default="false">
                                                    <xs:annotation><xs:documentation xml:lang="en">(VISIBILITY) State will be inverted</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="isCritical" type="g_bool">
                                                    <xs:annotation><xs:documentation xml:lang="en">Defines if dashboard update is critical and should be done every frame</xs:documentation><xs:appinfo><defaultStr>automatically based on type</defaultStr></xs:appinfo></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="lightTypes" type="g_vector_n">
                                                    <xs:annotation><xs:documentation xml:lang="en">Light types</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxActiveValue" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">Max. value to activate this dashboard</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxRot" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">(ROT) Max. rotation (Rotation value if rotAxis is given | Rotation Vector of rotAxis is not given)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxTrans" type="g_vector_trans">
                                                    <xs:annotation><xs:documentation xml:lang="en">(TRANS) Max. translation</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxValueAnim" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">(ANIMATION) Max. reference value for animation</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxValueRot" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">(ROT) Max. reference value for rotation</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxValueSlider" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">(SLIDER) Max. reference value for slider</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxValueTrans" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">(TRANS) Max. reference value for translation</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="minActiveValue" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">Min. value to activate this dashboard</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="minRot" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">(ROT) Min. rotation (Rotation value if rotAxis is given | Rotation Vector of rotAxis is not given)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="minTrans" type="g_vector_trans">
                                                    <xs:annotation><xs:documentation xml:lang="en">(TRANS) Min. translation</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="minValueAnim" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">(ANIMATION) Min. reference value for animation</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="minValueRot" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">(ROT) Min. reference value for rotation</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="minValueSlider" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">(SLIDER) Min. reference value for slider</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="minValueTrans" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">(TRANS) Min. reference value for translation</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="node" type="g_node_index">
                                                    <xs:annotation><xs:documentation xml:lang="en">Node</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="numberColor" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">(NUMBER) Numbers color (DashboardColor OR BrandColor OR r g b a)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="numbers" type="g_node_index">
                                                    <xs:annotation><xs:documentation xml:lang="en">(NUMBER) Numbers node</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="offsetValue" type="g_float" default="0">
