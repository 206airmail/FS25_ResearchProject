                                                </xs:attribute>
                                                <xs:attribute name="desc" type="g_l10n_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Configuration description</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="displayBrand" type="fs25_brand">
                                                    <xs:annotation><xs:documentation xml:lang="en">If defined a brand icon is displayed in the shop config screen</xs:documentation></xs:annotation>
                                                </xs:attribute>
