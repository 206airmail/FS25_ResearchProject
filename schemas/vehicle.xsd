                                                </xs:attribute>
                                                <xs:attribute name="attacherJointNodes" type="g_node_indices">
                                                    <xs:annotation><xs:documentation xml:lang="en">List of attacher joint indices to use (first active one is used)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="baseColor" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">(EMITTER) Base color (DashboardColor OR BrandColor OR r g b a)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="conditionalAnimationName" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Name of conditional animation</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="conditionalAnimationRange" type="g_vector_2">
                                                    <xs:annotation><xs:documentation xml:lang="en">Range of the conditional animation value</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="conditionGroupInverted" type="g_bool">
                                                    <xs:annotation><xs:documentation xml:lang="en">Invert the state of the condition group for the dashboard</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="conditionGroupName" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Name of the condition group</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="conditionStateName" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Name of condition state</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="disabledColor" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">(EMITTER) Disabled emit color (DashboardColor OR BrandColor OR r g b a)</xs:documentation></xs:annotation>
                                                </xs:attribute>
