        <xs:attribute name="ignoreWarning" type="g_bool" default="false">
            <xs:annotation><xs:documentation xml:lang="en">If set to &apos;true&apos; there is no warning if the material is not found.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="materialSlotName" type="g_string">
            <xs:annotation><xs:documentation xml:lang="en">Material slot name in the i3d file</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="materialTemplateName" type="g_string">
            <xs:annotation>
                <xs:documentation xml:lang="en">Name of template to apply (all attributes will be used from template)</xs:documentation>
                <xs:appinfo>
                    <typeStr>String</typeStr>
                    <giantsAutoCompletion sourceFile="$data/shared/brandMaterialTemplates.xml" prefix="">
                        <path>templates.template#name</path>
                    </giantsAutoCompletion>
                </xs:appinfo>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="materialTemplateUseColorOnly" type="g_bool" default="false">
            <xs:annotation><xs:documentation xml:lang="en">If &apos;true&apos;, only the color is used from the material template. The rest from the i3d file.</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="node" type="g_node_index">
            <xs:annotation><xs:documentation xml:lang="en">If defined, the &apos;targetMaterialSlotName&apos; is only replaced for this node</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="sourceMaterialSlotName" type="g_string">
            <xs:annotation><xs:documentation xml:lang="en">Material with this slot name replaces the material defined with &apos;targetMaterialSlotName&apos;</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="targetMaterialSlotName" type="g_string">
            <xs:annotation><xs:documentation xml:lang="en">Material with this slot name is replaced the material defined with &apos;sourceMaterialSlotName&apos;</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="useBaseColor" type="g_bool" default="false">
            <xs:annotation><xs:documentation xml:lang="en">Use base vehicle color</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="useDesignColorIndex" type="g_int">
            <xs:annotation><xs:documentation xml:lang="en">Use color of the design color with the defined index (1-16)</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="useRimColor" type="g_bool" default="false">
            <xs:annotation><xs:documentation xml:lang="en">Use rim color</xs:documentation></xs:annotation>
        </xs:attribute>
    </xs:complexType>

