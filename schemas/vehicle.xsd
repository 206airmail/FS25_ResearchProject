                                    </xs:attribute>
                                    <xs:attribute name="rotOffset" type="g_vector_rot" default="0 0 0">
                                        <xs:annotation><xs:documentation xml:lang="en">Rotation offset from joint node</xs:documentation></xs:annotation>
