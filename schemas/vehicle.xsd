                                        </xs:element>
                                    </xs:choice>
                                    <xs:attribute name="allowed" type="g_bool" default="false">
                                        <xs:annotation><xs:documentation xml:lang="en">When vehicle is not moving and steering keys are pressed turns on the same spot</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="direction" type="g_int" default="1">
                                        <xs:annotation><xs:documentation xml:lang="en">Driving direction [-1, 1]</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="lockDirection" type="g_bool" default="true">
                                        <xs:annotation><xs:documentation xml:lang="en">Defines if the direction is locked until player accelerates again</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="maxSpeed" type="g_float" default="10">
                                        <xs:annotation><xs:documentation xml:lang="en">Max. speed while turning</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="steeringFactor" type="g_float" default="100">
                                        <xs:annotation><xs:documentation xml:lang="en">Steering speed factor</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="updateSteeringWheel" type="g_bool" default="true">
                                        <xs:annotation><xs:documentation xml:lang="en">Update steering wheel</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
