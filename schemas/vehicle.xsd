        </xs:attribute>
        <xs:attribute name="lowerTransLimit" type="g_vector_3">
            <xs:annotation><xs:documentation xml:lang="en">Lower translation limit</xs:documentation><xs:appinfo><defaultStr>(0.5 0.5 0.5) for implement type, otherwise (0 0 0)</defaultStr></xs:appinfo></xs:annotation>
        </xs:attribute>
        <xs:attribute name="maxFillLevel" type="g_float" default="1">
            <xs:annotation><xs:documentation xml:lang="en">Max. fill level to activate attacher joint (pct between 0 and 1)</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="minFillLevel" type="g_float" default="0">
            <xs:annotation><xs:documentation xml:lang="en">Min. fill level to activate attacher joint (pct between 0 and 1)</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="moveTime" type="g_float" default="0.5">
            <xs:annotation><xs:documentation xml:lang="en">Move time</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="node" type="g_node_index">
            <xs:annotation><xs:documentation xml:lang="en">Node</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="nodeVisual" type="g_node_index">
            <xs:annotation><xs:documentation xml:lang="en">Visual node</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="rootNode" type="g_node_index">
            <xs:annotation><xs:documentation xml:lang="en">Root node</xs:documentation><xs:appinfo><defaultStr>Parent component of attacher joint node</defaultStr></xs:appinfo></xs:annotation>
        </xs:attribute>
        <xs:attribute name="rotLimitDamping" type="g_vector_3" default="1 1 1">
            <xs:annotation><xs:documentation xml:lang="en">Rotation limit damping</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="rotLimitForceLimit" type="g_vector_3" default="-1 -1 -1">
            <xs:annotation><xs:documentation xml:lang="en">Rotation limit force limit</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="rotLimitSpring" type="g_vector_3" default="0 0 0">
            <xs:annotation><xs:documentation xml:lang="en">Rotation limit spring</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="supportsHardAttach" type="g_bool">
            <xs:annotation><xs:documentation xml:lang="en">Supports hard attach</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="transLimitDamping" type="g_vector_3" default="1 1 1">
            <xs:annotation><xs:documentation xml:lang="en">Translation limit damping</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="transLimitForceLimit" type="g_vector_3" default="-1 -1 -1">
            <xs:annotation><xs:documentation xml:lang="en">Translation limit force limit</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="transLimitSpring" type="g_vector_3" default="0 0 0">
            <xs:annotation><xs:documentation xml:lang="en">Translation limit spring</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="upperRotationOffset" type="g_angle" default="0">
            <xs:annotation><xs:documentation xml:lang="en">Lower rotation offset</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="upperRotLimit" type="g_vector_rot">
            <xs:annotation><xs:documentation xml:lang="en">Upper rotation limit</xs:documentation><xs:appinfo><defaultStr>Lower rot limit</defaultStr></xs:appinfo></xs:annotation>
        </xs:attribute>
        <xs:attribute name="upperTransLimit" type="g_vector_3">
            <xs:annotation><xs:documentation xml:lang="en">Upper translation limit</xs:documentation><xs:appinfo><defaultStr>Lower trans limit</defaultStr></xs:appinfo></xs:annotation>
        </xs:attribute>
        <xs:attribute name="useTopLights" type="g_bool">
            <xs:annotation><xs:documentation xml:lang="en">Defines if the attacher joint enables the top lights if something is attached. Flag needs to be set on the implement as well.</xs:documentation><xs:appinfo><defaultStr>&apos;true&apos; if the attacher joint is on the front</defaultStr></xs:appinfo></xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:complexType name="VehicleConfigurationDataAdditionalMass">
