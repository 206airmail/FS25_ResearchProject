                                    <xs:attribute name="name" type="g_l10n_string">
                                        <xs:annotation><xs:documentation xml:lang="en">Set name</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="params" type="g_string">
                                        <xs:annotation><xs:documentation xml:lang="en">Parameters to insert into name</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:choice>
                        <xs:attribute name="isYesNoOption" type="g_bool" default="false">
                            <xs:annotation><xs:documentation xml:lang="en">Defines if the configuration set is a yes/no option</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="title" type="g_l10n_string">
                            <xs:annotation><xs:documentation xml:lang="en">Title to display in config screen</xs:documentation></xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="connectedAttributes" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:choice maxOccurs="unbounded">
                            <xs:element name="attribute" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:choice maxOccurs="unbounded">
                                        <xs:element name="combine" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="operation" type="g_string">
