                                    </xs:attribute>
                                    <xs:attribute name="requiredGroup" type="g_string">
                                        <xs:annotation><xs:documentation xml:lang="en">Optional group that needs to be active to control the state</xs:documentation></xs:annotation>
                                    </xs:attribute>
