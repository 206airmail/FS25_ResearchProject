                                                <xs:attribute name="valueType">
                                                    <xs:simpleType>
                                                        <xs:annotation><xs:documentation xml:lang="en">Value type name</xs:documentation></xs:annotation>
                                                        <xs:restriction base="xs:string">
                                                            <xs:enumeration value="conditionStateInput" />
                                                            <xs:enumeration value="conditionalAnimationState" />
                                                        </xs:restriction>
                                                    </xs:simpleType>
                                                </xs:attribute>
                                                <xs:attribute name="warningThresholdMax" type="g_float">
