                                                <xs:attribute name="steeringNodeIndex" type="g_int">
                                                    <xs:annotation><xs:documentation xml:lang="en">Index of steering node</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="textAlignment" type="g_string" default="RIGHT">
                                                    <xs:annotation><xs:documentation xml:lang="en">(TEXT) Alignment of text (LEFT | RIGHT | CENTER)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="textColor" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">(TEXT) Font color (DashboardColor OR BrandColor OR r g b a)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="textMask" type="g_string" default="00.0">
                                                    <xs:annotation><xs:documentation xml:lang="en">(TEXT) Font Mask</xs:documentation></xs:annotation>
                                                </xs:attribute>
