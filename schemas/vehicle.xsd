                                    </xs:attribute>
                                    <xs:attribute name="title" type="g_l10n_string">
                                        <xs:annotation><xs:documentation xml:lang="en">configuration title to display in shop</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:all>
                    </xs:complexType>
                </xs:element>
                <xs:element name="wheels" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:all>
                            <xs:element name="ackermannSteeringConfigurations" minOccurs="0" maxOccurs="1">
