                                        <xs:annotation><xs:documentation xml:lang="en">Link node</xs:documentation><xs:appinfo><defaultStr>0&gt;;</defaultStr></xs:appinfo></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="node" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">Node in external i3d file</xs:documentation><xs:appinfo><defaultStr>0|0</defaultStr></xs:appinfo></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="position" type="g_vector_trans" default="0 0 0">
                                        <xs:annotation><xs:documentation xml:lang="en">Position</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="rotation" type="g_vector_rot">
                                        <xs:annotation><xs:documentation xml:lang="en">Rotation node rotation</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="rotationNode" type="g_node_index">
