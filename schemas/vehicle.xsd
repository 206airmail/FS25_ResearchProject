                                                <xs:attribute name="value" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">New value id of the combined value</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="values" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Values to combine</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="prerequisites" minOccurs="0" maxOccurs="1">
                                            <xs:complexType>
                                                <xs:choice maxOccurs="unbounded">
                                                    <xs:element name="animation" minOccurs="0" maxOccurs="unbounded">
                                                        <xs:complexType>
                                                            <xs:attribute name="maxTime" type="g_float" default="1">
