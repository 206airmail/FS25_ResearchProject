                            <xs:complexType>
                                <xs:attribute name="node" type="g_node_index">
                                    <xs:annotation><xs:documentation xml:lang="en">The name of the clickbox node</xs:documentation></xs:annotation>
                                </xs:attribute>
                            </xs:complexType>
                        </xs:element>
                    </xs:choice>
                </xs:complexType>
            </xs:element>
            <xs:element name="holder" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                    <xs:attribute name="dummyFilename" type="g_string">
