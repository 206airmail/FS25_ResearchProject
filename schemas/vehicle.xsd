                                        <xs:element name="agentAttachment" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="hasCollision" type="g_bool" default="true">
                                                    <xs:annotation><xs:documentation xml:lang="en">Agent attachable is doing collision checks</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="height" type="g_float" default="3">
                                                    <xs:annotation><xs:documentation xml:lang="en">Agent attachable height</xs:documentation></xs:annotation>
