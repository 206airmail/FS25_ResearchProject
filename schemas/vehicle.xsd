        </xs:attribute>
        <xs:attribute name="enableCollision" type="g_bool" default="false">
            <xs:annotation><xs:documentation xml:lang="en">Collision between vehicle is enabled</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="fillUnitIndex" type="g_int" default="1">
            <xs:annotation><xs:documentation xml:lang="en">Reference fill unit index</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="fillUnitTopArmOnly" type="g_bool" default="false">
            <xs:annotation><xs:documentation xml:lang="en">Block attaching of implements with top arm only</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="isDefaultLowered" type="g_bool" default="false">
            <xs:annotation><xs:documentation xml:lang="en">Default lowered state</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="jointPositionOffset" type="g_vector_3" default="0 0 0">
            <xs:annotation><xs:documentation xml:lang="en">Joint position offset</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="jointType" type="fs25_jointType" default="implement">
            <xs:annotation><xs:documentation xml:lang="en">Joint type</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="lockDownRotLimit" type="g_bool" default="false">
            <xs:annotation><xs:documentation xml:lang="en">Lock down rotation limit</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="lockDownTransLimit" type="g_bool" default="true">
            <xs:annotation><xs:documentation xml:lang="en">Lock down translation limit</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="lockUpRotLimit" type="g_bool" default="false">
            <xs:annotation><xs:documentation xml:lang="en">Lock up rotation limit</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="lockUpTransLimit" type="g_bool" default="false">
            <xs:annotation><xs:documentation xml:lang="en">Lock up translation limit</xs:documentation></xs:annotation>
        </xs:attribute>
