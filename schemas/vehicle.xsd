                        <xs:annotation>
                            <xs:documentation xml:lang="en">Top arm material (applied to &apos;upperLink_main_mat&apos;)</xs:documentation>
                            <xs:appinfo>
                                <typeStr>Name of brand material template or color values (r,g,b)</typeStr>
                                <giantsAutoCompletion sourceFile="$data/shared/brandMaterialTemplates.xml" prefix="">
                                    <path>templates.template#name</path>
                                </giantsAutoCompletion>
                            </xs:appinfo>
                        </xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="materialTemplateName2" type="g_vehicle_material">
                        <xs:annotation>
                            <xs:documentation xml:lang="en">Top arm material 2 (applied to &apos;upperLink_base_mat&apos;)</xs:documentation>
                            <xs:appinfo>
                                <typeStr>Name of brand material template or color values (r,g,b)</typeStr>
                                <giantsAutoCompletion sourceFile="$data/shared/brandMaterialTemplates.xml" prefix="">
                                    <path>templates.template#name</path>
                                </giantsAutoCompletion>
                            </xs:appinfo>
                        </xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="mountArmRotation" type="g_vector_rot">
                        <xs:annotation><xs:documentation xml:lang="en">Defines a custom mount arm rotation while no tool is attached</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="referenceNode" type="g_node_index">
                        <xs:annotation><xs:documentation xml:lang="en">Reference node if top arm not loaded from i3d</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="rotationNode" type="g_node_index">
                        <xs:annotation><xs:documentation xml:lang="en">Rotation node if top arm not loaded from i3d</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="secondPartUseMainColor" type="g_bool" default="true">
                        <xs:annotation><xs:documentation xml:lang="en">Defines if the material &apos;upperLink_head_mat&apos; uses the &apos;material&apos; or &apos;material2&apos; value</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="toggleVisibility" type="g_bool" default="false">
                        <xs:annotation><xs:documentation xml:lang="en">Top arm will be hidden on detach</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="translationNode" type="g_node_index">
                        <xs:annotation><xs:documentation xml:lang="en">Translation node if top arm not loaded from i3d</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="useBrandDecal" type="g_bool" default="true">
                        <xs:annotation><xs:documentation xml:lang="en">Defines if the brand decal on the top arm is allowed or not</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="useMountArm" type="g_bool" default="true">
                        <xs:annotation><xs:documentation xml:lang="en">Defines if the mount arm is visible or not</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="zScale" type="g_int" default="1">
                        <xs:annotation><xs:documentation xml:lang="en">Inverts top arm direction</xs:documentation></xs:annotation>
                    </xs:attribute>
                </xs:complexType>
            </xs:element>
            <xs:element name="transNode" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                    <xs:all>
                        <xs:element name="dependentBottomArm" minOccurs="0" maxOccurs="1">
                            <xs:complexType>
                                <xs:attribute name="node" type="g_node_index">
                                    <xs:annotation><xs:documentation xml:lang="en">Dependent bottom arm node</xs:documentation></xs:annotation>
                                </xs:attribute>
                                <xs:attribute name="rotation" type="g_vector_rot" default="0 0 0">
                                    <xs:annotation><xs:documentation xml:lang="en">Rotation to be set when the translation node is below the threshold</xs:documentation></xs:annotation>
                                </xs:attribute>
                                <xs:attribute name="threshold" type="g_float">
                                    <xs:annotation><xs:documentation xml:lang="en">If the trans node Y translation is below this threshold the rotation will be set</xs:documentation><xs:appinfo><defaultStr>unlimited, so rotation is always set</defaultStr></xs:appinfo></xs:annotation>
                                </xs:attribute>
                            </xs:complexType>
                        </xs:element>
                    </xs:all>
                    <xs:attribute name="height" type="g_float" default="0.12">
                        <xs:annotation><xs:documentation xml:lang="en">Height of visual translation node</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="maxY" type="g_float">
                        <xs:annotation><xs:documentation xml:lang="en">Max Y translation</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="minY" type="g_float">
                        <xs:annotation><xs:documentation xml:lang="en">Min Y translation</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="node" type="g_node_index">
                        <xs:annotation><xs:documentation xml:lang="en">Translation node</xs:documentation></xs:annotation>
                    </xs:attribute>
                </xs:complexType>
            </xs:element>
            <xs:element name="visualAlignNode" minOccurs="0" maxOccurs="unbounded">
                <xs:complexType>
                    <xs:attribute name="delayedOnAttach" type="g_bool" default="true">
                        <xs:annotation><xs:documentation xml:lang="en">Node is updated after the smooth attach is finished</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="node" type="g_node_index">
                        <xs:annotation><xs:documentation xml:lang="en">Node of movingPart that should point towards the inputAttacherJoint node of the implement</xs:documentation></xs:annotation>
                    </xs:attribute>
                </xs:complexType>
            </xs:element>
            <xs:element name="visuals" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                    <xs:attribute name="hide" type="g_node_indices">
                        <xs:annotation><xs:documentation xml:lang="en">Visual nodes that will be hidden while attacher joint is active if there attacher is inactive</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="nodes" type="g_node_indices">
                        <xs:annotation><xs:documentation xml:lang="en">Visual nodes of attacher joint that will be visible when the joint is active</xs:documentation></xs:annotation>
                    </xs:attribute>
                </xs:complexType>
            </xs:element>
        </xs:choice>
        <xs:attribute name="allowDetachingWhileLifted" type="g_bool" default="true">
            <xs:annotation><xs:documentation xml:lang="en">Allow detach while lifted</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="allowFoldingWhileAttached" type="g_bool" default="true">
            <xs:annotation><xs:documentation xml:lang="en">Allow folding while attached</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="allowsJointLimitMovement" type="g_bool" default="true">
