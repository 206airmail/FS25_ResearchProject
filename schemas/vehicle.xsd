                                                <xs:attribute name="hideInactiveChildren" type="g_bool" default="false">
                                                    <xs:annotation><xs:documentation xml:lang="en">(EMITTER) Hide all the children when the dashboard is inactive</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="idleValue" type="g_float" default="0">
                                                    <xs:annotation><xs:documentation xml:lang="en">Idle value</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="inactiveColor" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">(EMITTER) Inactive emit color (DashboardColor OR BrandColor OR r g b a)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="inactiveGroups" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">(EMITTER) If defined, the inactive color/intensity will only be set if this group is active (if not active, the disabled color/intensity is used)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="inactiveIntensity" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">(EMITTER) Intensity while the dashboard state is not active, but the group is active</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="intensity" type="g_float" default="1">
                                                    <xs:annotation><xs:documentation xml:lang="en">Intensity</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="interpolationSpeed" type="g_float" default="0.005">
                                                    <xs:annotation><xs:documentation xml:lang="en">Interpolation speed</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="inverted" type="g_bool" default="false">
                                                    <xs:annotation><xs:documentation xml:lang="en">(VISIBILITY) State will be inverted</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="isCritical" type="g_bool">
                                                    <xs:annotation><xs:documentation xml:lang="en">Defines if dashboard update is critical and should be done every frame</xs:documentation><xs:appinfo><defaultStr>automatically based on type</defaultStr></xs:appinfo></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="lightTypes" type="g_vector_n">
                                                    <xs:annotation><xs:documentation xml:lang="en">Light types</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxActiveValue" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">Max. value to activate this dashboard</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxRot" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">(ROT) Max. rotation (Rotation value if rotAxis is given | Rotation Vector of rotAxis is not given)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxTrans" type="g_vector_trans">
                                                    <xs:annotation><xs:documentation xml:lang="en">(TRANS) Max. translation</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxValueAnim" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">(ANIMATION) Max. reference value for animation</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxValueRot" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">(ROT) Max. reference value for rotation</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxValueSlider" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">(SLIDER) Max. reference value for slider</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxValueTrans" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">(TRANS) Max. reference value for translation</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="minActiveValue" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">Min. value to activate this dashboard</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="minRot" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">(ROT) Min. rotation (Rotation value if rotAxis is given | Rotation Vector of rotAxis is not given)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="minTrans" type="g_vector_trans">
                                                    <xs:annotation><xs:documentation xml:lang="en">(TRANS) Min. translation</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="minValueAnim" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">(ANIMATION) Min. reference value for animation</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="minValueRot" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">(ROT) Min. reference value for rotation</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="minValueSlider" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">(SLIDER) Min. reference value for slider</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="minValueTrans" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">(TRANS) Min. reference value for translation</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="node" type="g_node_index">
                                                    <xs:annotation><xs:documentation xml:lang="en">Node</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="numberColor" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">(NUMBER) Numbers color (DashboardColor OR BrandColor OR r g b a)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="numbers" type="g_node_index">
                                                    <xs:annotation><xs:documentation xml:lang="en">(NUMBER) Numbers node</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="offsetValue" type="g_float" default="0">
                                                    <xs:annotation><xs:documentation xml:lang="en">Offset the value by the given amount</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="powerTakeOffIndex" type="g_int">
                                                    <xs:annotation><xs:documentation xml:lang="en">Index of power take off in xml to use</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="precision" type="g_int" default="1">
                                                    <xs:annotation><xs:documentation xml:lang="en">(NUMBER) Precision</xs:documentation></xs:annotation>
                                                </xs:attribute>
