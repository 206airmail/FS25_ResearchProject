                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="customShaderParameter" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="name" type="g_string">
