                                                <xs:attribute name="fillTypes" type="g_string_list">
                                                    <xs:annotation><xs:documentation xml:lang="en">list of fillTypes, space separated</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="fillTypesExclude" type="g_string_list">
                                                    <xs:annotation><xs:documentation xml:lang="en">list of fillType category names, space separated</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="priceScale" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">Price scale added for sold goods</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="trainSystemId" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Money will be added to the account of the current rental farm id of the train. This attribute is the unique id of the corresponding train system.</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="triggerNode" type="g_node_index">
                                                    <xs:annotation><xs:documentation xml:lang="en">Trigger node</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:choice>
                                    <xs:attribute name="allowMissions" type="g_bool" default="true">
                                        <xs:annotation><xs:documentation xml:lang="en">Allow missions</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="appearsOnStats" type="g_bool" default="false">
                                        <xs:annotation><xs:documentation xml:lang="en">Appears on Stats</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="fillTypeCategories" type="fs25_fillTypeCategoryList">
                                        <xs:annotation><xs:documentation xml:lang="en">Supported filltypes if no unloadtriggers defined</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="fillTypes" type="fs25_fillTypeList">
                                        <xs:annotation><xs:documentation xml:lang="en">Supported filltypes if no unloadtriggers defined</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="fullPriceRecoverHours" type="g_float">
                                        <xs:annotation><xs:documentation xml:lang="en">Full price recover ingame hours</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="hasDynamic" type="g_bool" default="true">
                                        <xs:annotation><xs:documentation xml:lang="en">Has dynamic prices</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="hideFromPricesMenu" type="g_bool" default="false">
                                        <xs:annotation><xs:documentation xml:lang="en">Hide station from prices menu</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="incomeName" type="g_string">
                                        <xs:annotation><xs:documentation xml:lang="en">Income name for stats</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="isPalletStation" type="g_bool" default="false">
                                        <xs:annotation><xs:documentation xml:lang="en">At this selling station good can be unloaded only as pallets</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="isTrainStation" type="g_bool" default="false">
                                        <xs:annotation><xs:documentation xml:lang="en">Is part of the train system</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="litersForFullPriceDrop" type="g_int">
                                        <xs:annotation><xs:documentation xml:lang="en">Liters for full price drop</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="node" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">Unloading station node</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="stationName" type="g_string" default="LoadingStation">
                                        <xs:annotation><xs:documentation xml:lang="en">Station name</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="storageRadius" type="g_float" default="50">
                                        <xs:annotation><xs:documentation xml:lang="en">Inside of this radius storages can be placed</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="supportsExtension" type="g_bool" default="false">
                                        <xs:annotation><xs:documentation xml:lang="en">Supports extensions</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="suppressWarnings" type="g_bool" default="false">
                                        <xs:annotation><xs:documentation xml:lang="en">Suppress warnings</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="sounds" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:all>
                                        <xs:element name="active" type="SoundManager_sound" minOccurs="0" maxOccurs="1"/>
                                        <xs:element name="idle" type="SoundManager_sound" minOccurs="0" maxOccurs="1"/>
                                    </xs:all>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="storage" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:choice maxOccurs="unbounded">
                                        <xs:element name="capacity" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="capacity" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">Custom filltype capacity</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="fillType" type="fs25_fillType">
                                                    <xs:annotation><xs:documentation xml:lang="en">Custom filltype capacity</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="dynamicFillPlane" minOccurs="0" maxOccurs="1">
                                            <xs:complexType>
                                                <xs:attribute name="allSidePlanes" type="g_bool" default="true">
                                                    <xs:annotation><xs:documentation xml:lang="en">All side planes</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="capacity" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">Visual capacity of the fill plane</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="changeColor" type="g_bool" default="false">
                                                    <xs:annotation><xs:documentation xml:lang="en">Fillplane supports color change</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="defaultFillType" type="fs25_fillType">
                                                    <xs:annotation><xs:documentation xml:lang="en">Fillplane default filltype</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxAllowedHeapAngle" type="g_angle" default="35">
                                                    <xs:annotation><xs:documentation xml:lang="en">Max. allowed heap surface slope angle [deg]</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxDelta" type="g_float" default="1">
                                                    <xs:annotation><xs:documentation xml:lang="en">Max. heap size above above input surface [m]</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxSubDivEdgeLength" type="g_float" default="0.9">
                                                    <xs:annotation><xs:documentation xml:lang="en">Max. length of sub division edges [m]</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxSurfaceDistanceError" type="g_float" default="0.05">
                                                    <xs:annotation><xs:documentation xml:lang="en">Max. allowed distance from input mesh surface to created fill plane mesh [m]</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="node" type="g_node_index">
                                                    <xs:annotation><xs:documentation xml:lang="en">Node</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="retessellateTop" type="g_bool" default="false">
                                                    <xs:annotation><xs:documentation xml:lang="en">Retessellate top plane for better triangulation quality</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="syncMaxSubDivEdgeLength" type="g_float" default="1.35">
                                                    <xs:annotation><xs:documentation xml:lang="en">Max. length of sub division edges used to sync in multiplayer [m]</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="fillPlane" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="changeVisibility" type="g_bool">
                                                    <xs:annotation><xs:documentation xml:lang="en">Hide node if state is zero</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="className" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Fillplane controller class</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="colorChange" type="g_bool" default="false">
                                                    <xs:annotation><xs:documentation xml:lang="en">Fill plane color change</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="fillType" type="fs25_fillType">
                                                    <xs:annotation><xs:documentation xml:lang="en">Fillplane fill type</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxRotX" type="g_angle">
                                                    <xs:annotation><xs:documentation xml:lang="en">Fill plane max rotation x</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxY" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">Fill plane max y</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="minRotX" type="g_angle">
                                                    <xs:annotation><xs:documentation xml:lang="en">Fill plane min rotation x</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="minY" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">Fill plane min y</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="node" type="g_node_index">
                                                    <xs:annotation><xs:documentation xml:lang="en">Fill plane node</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="startFillLevel" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="fillLevel" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">Start filllevel</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="fillType" type="fs25_fillType">
                                                    <xs:annotation><xs:documentation xml:lang="en">Start filllevel fill type</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:choice>
                                    <xs:attribute name="capacity" type="g_float" default="100000">
                                        <xs:annotation><xs:documentation xml:lang="en">Total capacity</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="costsPerFillLevelAndDay" type="g_float" default="0">
                                        <xs:annotation><xs:documentation xml:lang="en">Costs per fill level and day</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="fillLevelSyncThreshold" type="g_float" default="1">
                                        <xs:annotation><xs:documentation xml:lang="en">Fill level difference needed for synchronization in Multiplayer</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="fillTypeCategories" type="fs25_fillTypeCategoryList">
                                        <xs:annotation><xs:documentation xml:lang="en">Supported fill type categories</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="fillTypes" type="fs25_fillTypeList">
                                        <xs:annotation><xs:documentation xml:lang="en">Supported fill types</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="isExtension" type="g_bool">
                                        <xs:annotation><xs:documentation xml:lang="en">If storage is an extension</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="node" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">Storage node</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="supportsMultipleFillTypes" type="g_bool" default="true">
                                        <xs:annotation><xs:documentation xml:lang="en">If true capacity can be used by multiple fill types at the same time. If false only one filltype is allowed</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:all>
                        <xs:attribute name="isFinalized" type="g_bool">
                            <xs:annotation><xs:documentation xml:lang="en">If the production point is finalized and ready on start. E.g. constructible</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="name" type="g_string" default="unnamed production point">
                            <xs:annotation><xs:documentation xml:lang="en">Name of the Production Point</xs:documentation></xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="riceField" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:all>
                            <xs:element name="area" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="groundType" type="fs25_groundType" default="dirt">
                                    </xs:attribute>
                                    <xs:attribute name="offsetFromRidge" type="g_float">
                                        <xs:annotation><xs:documentation xml:lang="en">distance in m the ground type inside the rice field if offset from the ridge center</xs:documentation><xs:appinfo><defaultStr>-0.5</defaultStr></xs:appinfo></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="foliage" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="fruitTypes" type="fs25_fruitTypeList">
                                    </xs:attribute>
                                    <xs:attribute name="offsetFromRidge" type="g_float">
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="playerTrigger" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="node" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">node of the player trigger</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="pump" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:all>
                                        <xs:element name="emptying" minOccurs="0" maxOccurs="1">
                                            <xs:complexType>
                                                <xs:attribute name="splash" type="g_node_index">
                                                    <xs:annotation><xs:documentation xml:lang="en">node index path to emptying water splash mesh</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="water" type="g_node_index">
                                                    <xs:annotation><xs:documentation xml:lang="en">node index path to emptying water mesh</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="filling" minOccurs="0" maxOccurs="1">
                                            <xs:complexType>
                                                <xs:attribute name="splash" type="g_node_index">
                                                    <xs:annotation><xs:documentation xml:lang="en">node index path to filling water splash mesh</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="water" type="g_node_index">
                                                    <xs:annotation><xs:documentation xml:lang="en">node index path to filling water mesh</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="yOffset" type="g_float" default="0.07">
                                                    <xs:annotation><xs:documentation xml:lang="en">y offset of the splash above the water plane</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="sounds" minOccurs="0" maxOccurs="1">
                                            <xs:complexType>
                                                <xs:all>
                                                    <xs:element name="pump" minOccurs="0" maxOccurs="1">
                                                        <xs:complexType>
                                                            <xs:choice maxOccurs="unbounded">
                                                                <xs:element name="loopSynthesisLoad" type="SoundManager_sound" minOccurs="0" maxOccurs="1"/>
                                                                <xs:element name="loopSynthesisRpm" type="SoundManager_sound" minOccurs="0" maxOccurs="1"/>
                                                                <xs:element name="lowpassCutoffFrequency" type="SoundManager_sound" minOccurs="0" maxOccurs="1"/>
                                                                <xs:element name="lowpassGain" type="SoundManager_sound" minOccurs="0" maxOccurs="1"/>
                                                                <xs:element name="lowpassResonance" type="SoundManager_sound" minOccurs="0" maxOccurs="1"/>
                                                                <xs:element name="pitch" type="SoundManager_sound" minOccurs="0" maxOccurs="1"/>
                                                                <xs:element name="randomization" type="SoundManager_sound" minOccurs="0" maxOccurs="unbounded"/>
                                                                <xs:element name="sourceRandomization" type="SoundManager_sound" minOccurs="0" maxOccurs="unbounded"/>
                                                                <xs:element name="volume" type="SoundManager_sound" minOccurs="0" maxOccurs="1"/>
                                                            </xs:choice>
                                                            <xs:attribute name="debug" type="g_bool" default="false">
                                                                <xs:annotation><xs:documentation xml:lang="en">Flag to enable debug rendering</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="fadeIn" type="g_float" default="0">
                                                                <xs:annotation><xs:documentation xml:lang="en">Fade in time in seconds</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="fadeOut" type="g_float" default="0">
                                                                <xs:annotation><xs:documentation xml:lang="en">Fade out time in seconds</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="file" type="g_string">
                                                                <xs:annotation><xs:documentation xml:lang="en">Path to sound sample</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="innerRadius" type="g_float" default="80">
                                                                <xs:annotation><xs:documentation xml:lang="en">Inner radius</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="isLocalSound" type="g_bool" default="false">
                                                                <xs:annotation><xs:documentation xml:lang="en">While set for vehicle sounds it will only play for the player currently using the vehicle</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="linkNode" type="g_node_index">
                                                                <xs:annotation><xs:documentation xml:lang="en">Link node for 3d sound</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="linkNodeOffset" type="g_vector_trans">
                                                                <xs:annotation><xs:documentation xml:lang="en">Sound source will be offset by this value to the link node</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="loops" type="g_int" default="1">
                                                                <xs:annotation><xs:documentation xml:lang="en">Number of loops (0 = infinite)</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="loopSynthesisRPMRatio" type="g_float" default="1">
                                                                <xs:annotation><xs:documentation xml:lang="en">Ratio between rpm in the gls file and actual rpm of the motor (e.g. 0.9: max. rpm in the gls file will be reached at 90% of motor rpm)</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="lowpassGainScale" type="g_float" default="1">
                                                                <xs:annotation><xs:documentation xml:lang="en">Additional lowpass gain that is applied on the volume attributes</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="outerRadius" type="g_float" default="5">
                                                                <xs:annotation><xs:documentation xml:lang="en">Outer radius</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="parent" type="g_string">
                                                                <xs:annotation><xs:documentation xml:lang="en">Parent sample for inheritance</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="pitchScale" type="g_float" default="1">
                                                                <xs:annotation><xs:documentation xml:lang="en">Additional pitch that is applied on the volume attributes</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="priority" default="MEDIUM">
                                                                <xs:simpleType>
                                                                    <xs:annotation><xs:documentation xml:lang="en">Priority of the sound</xs:documentation></xs:annotation>
                                                                    <xs:restriction base="xs:string">
                                                                        <xs:enumeration value="VERY_LOW" />
                                                                        <xs:enumeration value="MEDIUM" />
                                                                        <xs:enumeration value="HIGH" />
                                                                        <xs:enumeration value="LOW" />
                                                                        <xs:enumeration value="VERY_HIGH" />
                                                                    </xs:restriction>
                                                                </xs:simpleType>
                                                            </xs:attribute>
                                                            <xs:attribute name="supportsReverb" type="g_bool" default="true">
                                                                <xs:annotation><xs:documentation xml:lang="en">Flag to disable reverb</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="template" type="g_string">
                                                                <xs:annotation>
                                                                    <xs:documentation xml:lang="en">Sound template name</xs:documentation>
                                                                    <xs:appinfo>
                                                                        <typeStr>String</typeStr>
                                                                        <giantsAutoCompletion sourceFile="$data/sounds/soundTemplates.xml" prefix="">
                                                                            <path>soundTemplates.template#name</path>
                                                                        </giantsAutoCompletion>
                                                                    </xs:appinfo>
                                                                </xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="volumeScale" type="g_float" default="1">
                                                                <xs:annotation><xs:documentation xml:lang="en">Additional scale that is applied on the volume attributes</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                        </xs:complexType>
                                                    </xs:element>
                                                    <xs:element name="water" type="SoundManager_sound" minOccurs="0" maxOccurs="1"/>
                                                </xs:all>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:all>
                                    <xs:attribute name="filename" type="g_filename">
                                        <xs:annotation><xs:documentation xml:lang="en">filepath to pump i3d file</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="ridge" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="foliageGrowthState" type="g_int" default="2">
                                        <xs:annotation><xs:documentation xml:lang="en">foliage growth state</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="foliageGrowthStateName" type="g_string">
                                        <xs:annotation><xs:documentation xml:lang="en">foliage growth state name</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="foliageOffsetFromRidge" type="g_float">
                                        <xs:annotation><xs:documentation xml:lang="en">foliage offset</xs:documentation><xs:appinfo><defaultStr>0.5</defaultStr></xs:appinfo></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="foliageType" type="g_string">
                                        <xs:annotation><xs:documentation xml:lang="en">foliage to place ontop of ridge</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="foliageWidth" type="g_float">
                                        <xs:annotation><xs:documentation xml:lang="en">foliage width</xs:documentation><xs:appinfo><defaultStr>paintWidth / 2</defaultStr></xs:appinfo></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="groundType" type="fs25_groundType" default="grass">
                                    </xs:attribute>
                                    <xs:attribute name="height" type="g_float" default="0.35">
                                        <xs:annotation><xs:documentation xml:lang="en">height of the ridge around the rice field in m</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="levelingWidth" type="g_float" default="0.45">
                                        <xs:annotation><xs:documentation xml:lang="en">width of the ridge terrain leveling in m</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="paintWidth" type="g_float" default="1">
                                        <xs:annotation><xs:documentation xml:lang="en">width of the painted area on the ridge around the rice field in m</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="water" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="fillDurationGameMinutes" type="g_float">
                                        <xs:annotation><xs:documentation xml:lang="en">duration for fully filling field in game minutes</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="maxLevel" type="g_float">
                                        <xs:annotation><xs:documentation xml:lang="en">maximum height of the water</xs:documentation><xs:appinfo><defaultStr>80% or ridge height</defaultStr></xs:appinfo></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="underwaterFogColor" type="g_vector_4">
                                        <xs:annotation><xs:documentation xml:lang="en">shader paramters for underwaterFogColor</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="underwaterFogDepth" type="g_vector_4">
                                        <xs:annotation><xs:documentation xml:lang="en">shader paramters for underwaterFogDepth</xs:documentation></xs:annotation>
                                    </xs:attribute>
