                                                <xs:attribute name="autoUnload" type="g_bool" default="false">
                                                    <xs:annotation><xs:documentation xml:lang="en">Wood is automatically unloaded</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="exactFillRootNode" type="g_node_index">
                                                    <xs:annotation><xs:documentation xml:lang="en">Exact fill root node</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="fillTypeCategories" type="g_string_list">
                                                    <xs:annotation><xs:documentation xml:lang="en">list of fillType category names, space separated</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="fillTypes" type="g_string_list">
                                                    <xs:annotation><xs:documentation xml:lang="en">list of fillTypes, space separated</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="fillTypesExclude" type="g_string_list">
                                                    <xs:annotation><xs:documentation xml:lang="en">list of fillType category names, space separated</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="priceScale" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">Price scale added for sold goods</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="trainSystemId" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Money will be added to the account of the current rental farm id of the train. This attribute is the unique id of the corresponding train system.</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="triggerNode" type="g_node_index">
                                                    <xs:annotation><xs:documentation xml:lang="en">Trigger node</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:choice>
                                    <xs:attribute name="hideFromPricesMenu" type="g_bool" default="false">
                                        <xs:annotation><xs:documentation xml:lang="en">Hide station from prices menu</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="isPalletStation" type="g_bool" default="false">
                                        <xs:annotation><xs:documentation xml:lang="en">At this selling station good can be unloaded only as pallets</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="isTrainStation" type="g_bool" default="false">
                                        <xs:annotation><xs:documentation xml:lang="en">Is part of the train system</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="node" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">Unloading station node</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="stationName" type="g_string" default="LoadingStation">
                                        <xs:annotation><xs:documentation xml:lang="en">Station name</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="storageRadius" type="g_float" default="50">
                                        <xs:annotation><xs:documentation xml:lang="en">Inside of this radius storages can be placed</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="supportsExtension" type="g_bool" default="false">
                                        <xs:annotation><xs:documentation xml:lang="en">Supports extensions</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:all>
                        <xs:attribute name="actionRadius" type="g_float">
                            <xs:annotation><xs:documentation xml:lang="en">Radius of the spot in m</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="probabilityFactor" type="g_float" default="0.5">
                            <xs:annotation><xs:documentation xml:lang="en">Factor that is multiplied with the default probability</xs:documentation></xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="windTurbine" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:all>
                            <xs:element name="animationNodes" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:choice maxOccurs="unbounded">
                                        <xs:element name="animationNode" type="AnimationNode" minOccurs="0" maxOccurs="unbounded"/>
                                    </xs:choice>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="sounds" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:all>
                                        <xs:element name="idle" type="SoundManager_sound" minOccurs="0" maxOccurs="1"/>
                                    </xs:all>
                                </xs:complexType>
                            </xs:element>
                        </xs:all>
                        <xs:attribute name="headAdjustToWind" type="g_bool">
                            <xs:annotation><xs:documentation xml:lang="en">Adjust head node to current wind direction</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="headNode" type="g_node_index">
                            <xs:annotation><xs:documentation xml:lang="en">Head node</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="incomePerHour" type="g_float">
                            <xs:annotation><xs:documentation xml:lang="en">Income per hour</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="isFinalized" type="g_bool">
                            <xs:annotation><xs:documentation xml:lang="en">If the wind turbine is finalized and ready on start. E.g. constructible</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="optimalWindSpeed" type="g_float">
                            <xs:annotation><xs:documentation xml:lang="en">Wind speed in m/s at which rotor reaches max rpm</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="rotationNode" type="g_node_index">
                            <xs:annotation><xs:documentation xml:lang="en">Rotor rotation node, rotated on z-axis</xs:documentation></xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="workshop" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:all>
                            <xs:element name="sellingPoint" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="iconNode" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">Icon node</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="mobileWorkshop" type="g_bool" default="false">
                                        <xs:annotation><xs:documentation xml:lang="en">Workshop is on vehicle</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="ownWorkshop" type="g_bool" default="false">
                                        <xs:annotation><xs:documentation xml:lang="en">Owned by player</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="playerTriggerNode" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">Player trigger node</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="sellTriggerNode" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">Sell trigger node</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:all>
                    </xs:complexType>
                </xs:element>
            </xs:all>
            <xs:attribute name="type" type="g_string" use="required">
                <xs:annotation>
                    <xs:documentation xml:lang="en">Placeable type</xs:documentation>
                    <xs:appinfo>
                        <typeStr>String</typeStr>
                        <giantsAutoCompletion sourceFile="$dataS/placeableTypes.xml" prefix="">
                            <path>placeableTypes.type#name</path>
                        </giantsAutoCompletion>
                    </xs:appinfo>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
</xs:schema>
