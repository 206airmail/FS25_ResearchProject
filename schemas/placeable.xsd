                                            </xs:attribute>
                                            <xs:attribute name="scale" type="g_vector_scale">
                                                <xs:annotation><xs:documentation xml:lang="en">(VariableMotionPathEffect) Scale of the mesh in this state</xs:documentation></xs:annotation>
                                            </xs:attribute>
                                            <xs:attribute name="speedScale" type="g_float">
                                                <xs:annotation><xs:documentation xml:lang="en">(VariableMotionPathEffect) Speed scale in this state</xs:documentation></xs:annotation>
                                            </xs:attribute>
