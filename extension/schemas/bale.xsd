                                            <xs:complexType>
                                                <xs:attribute name="filename" type="g_filename">
                                                    <xs:annotation><xs:documentation xml:lang="en">Diffuse texture to apply to all mesh nodes</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="useFillTypeArray" type="g_bool" default="false">
                                                    <xs:annotation><xs:documentation xml:lang="en">Use the fill type array texture for diffuse</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="netWrapDiffuse" minOccurs="0" maxOccurs="1">
                                            <xs:complexType>
                                                <xs:attribute name="filename" type="g_filename">
                                                    <xs:annotation><xs:documentation xml:lang="en">Net wrap diffuse texture to apply to all mesh nodes</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="netWrapNormal" minOccurs="0" maxOccurs="1">
                                            <xs:complexType>
                                                <xs:attribute name="filename" type="g_filename">
                                                    <xs:annotation><xs:documentation xml:lang="en">Net Wrap normal texture to apply to all mesh nodes</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="normal" minOccurs="0" maxOccurs="1">
                                            <xs:complexType>
                                                <xs:attribute name="filename" type="g_filename">
                                                    <xs:annotation><xs:documentation xml:lang="en">Normal texture to apply to all mesh nodes</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="useFillTypeArray" type="g_bool" default="false">
                                                    <xs:annotation><xs:documentation xml:lang="en">Use the fill type array texture for normal</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:all>
                                    <xs:attribute name="id" type="g_string">
                                        <xs:annotation><xs:documentation xml:lang="en">Variation identifier</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:choice>
                    </xs:complexType>
                </xs:element>
            </xs:all>
