                            <xs:annotation><xs:documentation xml:lang="en">Max. stack height for automatic spawning of bales</xs:documentation><xs:appinfo><defaultStr>2 or round bales and 3 for square bales</defaultStr></xs:appinfo></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="visualDiameter" type="g_float">
                            <xs:annotation><xs:documentation xml:lang="en">Bale Diameter (Real size of the visuals if different)</xs:documentation><xs:appinfo><defaultStr>Same as #diameter</defaultStr></xs:appinfo></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="visualHeight" type="g_float">
                            <xs:annotation><xs:documentation xml:lang="en">Bale Height (Real size of the visuals if different)</xs:documentation><xs:appinfo><defaultStr>Same as #height</defaultStr></xs:appinfo></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="visualLength" type="g_float">
                            <xs:annotation><xs:documentation xml:lang="en">Bale Length (Real size of the visuals if different)</xs:documentation><xs:appinfo><defaultStr>Same as #length</defaultStr></xs:appinfo></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="visualWidth" type="g_float">
                            <xs:annotation><xs:documentation xml:lang="en">Bale Width (Real size of the visuals if different)</xs:documentation><xs:appinfo><defaultStr>Same as #width</defaultStr></xs:appinfo></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="width" type="g_float" default="0">
                            <xs:annotation><xs:documentation xml:lang="en">Bale Width</xs:documentation></xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="uvId" type="g_string" minOccurs="0">
                    <xs:annotation><xs:documentation xml:lang="en">Specify that this bale model has a custom UV. This will result in baleWrapper to replace the bale if the UV is different to the defined one in the baleWrapper. So the baleWrapper will always use a bale with a UV that matches the wrapping texture.</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="variations" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:choice maxOccurs="unbounded">
                            <xs:element name="variation" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:all>
                                        <xs:element name="alpha" minOccurs="0" maxOccurs="1">
                                            <xs:complexType>
                                                <xs:attribute name="filename" type="g_filename">
                                                    <xs:annotation><xs:documentation xml:lang="en">Alpha texture to apply to all mesh nodes</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="baleNormal" minOccurs="0" maxOccurs="1">
