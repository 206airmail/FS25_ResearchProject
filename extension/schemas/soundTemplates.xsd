                                                            <xs:enumeration value="ACCELERATE" />
                                                            <xs:enumeration value="TURNED_ON_SPEED" />
                                                            <xs:enumeration value="MOTOR_RPM" />
                                                            <xs:enumeration value="BRAKE_TIME" />
                                                        </xs:restriction>
                                                    </xs:simpleType>
