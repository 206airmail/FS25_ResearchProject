                                                            <xs:enumeration value="ROLLERCOASTER_SPEED" />
                                                            <xs:enumeration value="BOATYARD_LAUNCHING_SPEED" />
                                                            <xs:enumeration value="WIND_TURBINE_LOAD" />
                                                            <xs:enumeration value="CARRIAGE_SPEED" />
                                                            <xs:enumeration value="BLOW_OFF_VALVE_STATE" />
                                                            <xs:enumeration value="DECELERATE" />
                                                            <xs:enumeration value="ACCELERATE" />
