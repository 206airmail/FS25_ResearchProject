                    </xs:attribute>
                    <xs:attribute name="rotSpeed" type="g_angle">
                        <xs:annotation><xs:documentation xml:lang="en">Rotation speed</xs:documentation><xs:appinfo><defaultStr>Default rotation speed</defaultStr></xs:appinfo></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="scrollSpeed" type="g_float">
                        <xs:annotation><xs:documentation xml:lang="en">(ScrollingAnimation) Scroll speed</xs:documentation><xs:appinfo><defaultStr>Default scroll speed</defaultStr></xs:appinfo></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="speedScale" type="g_float" default="1">
                        <xs:annotation><xs:documentation xml:lang="en">Speed scale</xs:documentation></xs:annotation>
                    </xs:attribute>
