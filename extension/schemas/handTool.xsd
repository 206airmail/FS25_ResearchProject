                                                                            <xs:annotation><xs:documentation xml:lang="en">Index Path of node to load</xs:documentation></xs:annotation>
                                                                        </xs:attribute>
                                                                        <xs:attribute name="rotation" type="g_vector_rot" default="0 0 0">
                                                                            <xs:annotation><xs:documentation xml:lang="en">Rotation</xs:documentation></xs:annotation>
                                                                        </xs:attribute>
                                                                        <xs:attribute name="scale" type="g_vector_scale" default="1 1 1">
                                                                            <xs:annotation><xs:documentation xml:lang="en">Scale</xs:documentation></xs:annotation>
                                                                        </xs:attribute>
                                                                        <xs:attribute name="translation" type="g_vector_trans" default="0 0 0">
                                                                            <xs:annotation><xs:documentation xml:lang="en">Translation</xs:documentation></xs:annotation>
                                                                        </xs:attribute>
                                                                    </xs:complexType>
                                                                </xs:element>
                                                            </xs:choice>
                                                            <xs:attribute name="filename" type="g_string">
                                                                <xs:annotation><xs:documentation xml:lang="en">Path to i3d file</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:choice>
                                                <xs:attribute name="useClipPlane" type="g_bool">
                                                    <xs:annotation><xs:documentation xml:lang="en">Clip plane is used</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="settings" minOccurs="0" maxOccurs="1">
                                            <xs:complexType>
                                                <xs:attribute name="advancedBoundingBox" type="g_bool">
                                                    <xs:annotation><xs:documentation xml:lang="en">Advanced BB is used for icon placement</xs:documentation><xs:appinfo><defaultStr>Setting from Icon Generator</defaultStr></xs:appinfo></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="cameraXRot" type="g_angle">
                                                    <xs:annotation><xs:documentation xml:lang="en">X Rot of camera</xs:documentation><xs:appinfo><defaultStr>Setting from Icon Generator</defaultStr></xs:appinfo></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="cameraYRot" type="g_angle">
