                                <xs:annotation><xs:documentation xml:lang="en">Texture memory usage</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="vertexBufferMemoryUsage" type="g_int" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">Vertex buffer memory usage</xs:documentation></xs:annotation>
                            </xs:element>
                        </xs:all>
