                                    </xs:attribute>
                                    <xs:attribute name="walking" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">The name of the node used to position the chainsaw while walking</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="playerWorkStylePreset" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">Name of the style preset</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="ringSelector" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="filename" type="g_string" use="required">
                                        <xs:annotation><xs:documentation xml:lang="en">The path of the ring selector i3d file</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="scaleOffset" type="g_float" default="0">
                                        <xs:annotation><xs:documentation xml:lang="en">The size in metres added onto the ring indicator&apos;s scale</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="sounds" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:choice maxOccurs="unbounded">
                                        <xs:element name="cut" type="SoundManager_sound" minOccurs="0" maxOccurs="unbounded"/>
                                    </xs:choice>
                                </xs:complexType>
                            </xs:element>
                        </xs:all>
                        <xs:attribute name="cutTimePerSquareMeter" type="g_float" default="1">
                            <xs:annotation><xs:documentation xml:lang="en">The time in seconds per square metre that the chainsaw takes to cut</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="maximumCutDiameter" type="g_float" default="1">
                            <xs:annotation><xs:documentation xml:lang="en">The maximum diameter in metres that can be cut</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="maximumDelimbDiameter" type="g_float" default="1">
                            <xs:annotation><xs:documentation xml:lang="en">The maximum diameter range in metres that is used for delimb</xs:documentation></xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="fishingRod" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:all>
                            <xs:element name="bail" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="node" type="g_node_index">
