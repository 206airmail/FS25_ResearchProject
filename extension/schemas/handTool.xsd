            <xs:annotation><xs:documentation xml:lang="en">Path to sound sample</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="innerRadius" type="g_float" default="80">
            <xs:annotation><xs:documentation xml:lang="en">Inner radius</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="isLocalSound" type="g_bool" default="false">
            <xs:annotation><xs:documentation xml:lang="en">While set for vehicle sounds it will only play for the player currently using the vehicle</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="linkNode" type="g_node_index">
            <xs:annotation><xs:documentation xml:lang="en">Link node for 3d sound</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="linkNodeOffset" type="g_vector_trans">
            <xs:annotation><xs:documentation xml:lang="en">Sound source will be offset by this value to the link node</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="loops" type="g_int" default="1">
            <xs:annotation><xs:documentation xml:lang="en">Number of loops (0 = infinite)</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="loopSynthesisRPMRatio" type="g_float" default="1">
            <xs:annotation><xs:documentation xml:lang="en">Ratio between rpm in the gls file and actual rpm of the motor (e.g. 0.9: max. rpm in the gls file will be reached at 90% of motor rpm)</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="lowpassGainScale" type="g_float" default="1">
            <xs:annotation><xs:documentation xml:lang="en">Additional lowpass gain that is applied on the volume attributes</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="outerRadius" type="g_float" default="5">
            <xs:annotation><xs:documentation xml:lang="en">Outer radius</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="parent" type="g_string">
            <xs:annotation><xs:documentation xml:lang="en">Parent sample for inheritance</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="pitchScale" type="g_float" default="1">
            <xs:annotation><xs:documentation xml:lang="en">Additional pitch that is applied on the volume attributes</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="priority" default="MEDIUM">
            <xs:simpleType>
                <xs:annotation><xs:documentation xml:lang="en">Priority of the sound</xs:documentation></xs:annotation>
                <xs:restriction base="xs:string">
                    <xs:enumeration value="VERY_LOW" />
                    <xs:enumeration value="MEDIUM" />
                    <xs:enumeration value="HIGH" />
                    <xs:enumeration value="LOW" />
                    <xs:enumeration value="VERY_HIGH" />
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="supportsReverb" type="g_bool" default="true">
            <xs:annotation><xs:documentation xml:lang="en">Flag to disable reverb</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="template" type="g_string">
            <xs:annotation>
                <xs:documentation xml:lang="en">Sound template name</xs:documentation>
                <xs:appinfo>
                    <typeStr>String</typeStr>
                    <giantsAutoCompletion sourceFile="$data/sounds/soundTemplates.xml" prefix="">
                        <path>soundTemplates.template#name</path>
                    </giantsAutoCompletion>
                </xs:appinfo>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="volumeScale" type="g_float" default="1">
            <xs:annotation><xs:documentation xml:lang="en">Additional scale that is applied on the volume attributes</xs:documentation></xs:annotation>
        </xs:attribute>
    </xs:complexType>

    <xs:element name="handTool">
        <xs:complexType>
            <xs:all>
                <xs:element name="annotation" type="g_string" minOccurs="1">
                    <xs:annotation><xs:documentation xml:lang="en">Annotation</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="base" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:all>
                            <xs:element name="actions" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="activate" type="g_l10n_string">
                                        <xs:annotation><xs:documentation xml:lang="en">The text displayed for activating the tool</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="carried" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="node" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">The node used to position the hand tool when not held</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="targetNode" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">The node of the player character that the tool is attached to when not held</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="filename" type="g_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">Hand tool i3d file</xs:documentation></xs:annotation>
                            </xs:element>
                            <xs:element name="firstPersonNode" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="node" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">The node used to position the hand tool when held in first person</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="graphics" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="lockFirstPerson" type="g_bool">
                                        <xs:annotation><xs:documentation xml:lang="en">True if first person mode should be forced, false for third person. A lack of this attribute does not lock the perspective at all</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="node" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">The node containing all the graphical nodes of the tool</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="handNode" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="node" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">The node used to position the hand tool when held in third person</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="useLeftHand" type="g_bool">
                                        <xs:annotation><xs:documentation xml:lang="en">If the handtool should be attached to player left hand</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="sounds" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="filename" type="g_string">
                                        <xs:annotation><xs:documentation xml:lang="en">The filename of the xml file defining the sounds of the tool</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="typeDesc" type="g_l10n_string" minOccurs="0">
                                <xs:annotation><xs:documentation xml:lang="en">Hand tool name localization string</xs:documentation></xs:annotation>
                            </xs:element>
                        </xs:all>
                        <xs:attribute name="canBeDropped" type="g_bool">
                            <xs:annotation><xs:documentation xml:lang="en">True if this tool can be dropped to inventory</xs:documentation><xs:appinfo><defaultStr>Defaults to true, so that the tool will be dropped</defaultStr></xs:appinfo></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="canBeSaved" type="g_bool">
                            <xs:annotation><xs:documentation xml:lang="en">True if this tool can be saved; false otherwise</xs:documentation><xs:appinfo><defaultStr>Defaults to true, so that the tool will be saved</defaultStr></xs:appinfo></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="canCrouch" type="g_bool" default="true">
                            <xs:annotation><xs:documentation xml:lang="en">If the player can crouch while holding this tool</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="jumpMultiplier" type="g_float">
                            <xs:annotation><xs:documentation xml:lang="en">The amount of jump strength the player gains while walking with this tool</xs:documentation><xs:appinfo><defaultStr>true</defaultStr></xs:appinfo></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="mass" type="g_float">
                            <xs:annotation><xs:documentation xml:lang="en">Mass in kilograms</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="mustBeHeld" type="g_bool" default="false">
                            <xs:annotation><xs:documentation xml:lang="en">True if this tool must be held, and cannot be put away; false otherwise</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="runMultiplier" type="g_float">
                            <xs:annotation><xs:documentation xml:lang="en">The amount of run speed the player gains while running with this tool</xs:documentation><xs:appinfo><defaultStr>true</defaultStr></xs:appinfo></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="walkMultiplier" type="g_float">
                            <xs:annotation><xs:documentation xml:lang="en">The amount of walk speed the player gains while walking with this tool</xs:documentation><xs:appinfo><defaultStr>true</defaultStr></xs:appinfo></xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="chainsaw" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:all>
                            <xs:element name="chain" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:choice maxOccurs="unbounded">
                                        <xs:element name="animationNode" type="AnimationNode" minOccurs="0" maxOccurs="unbounded"/>
                                    </xs:choice>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="cutNode" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="node" type="g_node_index">
