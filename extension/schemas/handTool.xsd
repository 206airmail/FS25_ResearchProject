                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="bobber" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="node" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">Bobber floating on the water when cast</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="physicsNode" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">Physical helper node for fishing line</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="extendAnimation" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:choice maxOccurs="unbounded">
                                        <xs:element name="part" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:choice maxOccurs="unbounded">
                                                    <xs:element name="keyFrame" minOccurs="0" maxOccurs="unbounded">
                                                        <xs:complexType>
                                                            <xs:attribute name="time" type="g_float">
                                                            </xs:attribute>
                                                            <xs:attribute name="translation" type="g_vector_trans">
                                                            </xs:attribute>
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:choice>
                                                <xs:attribute name="node" type="g_node_index">
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:choice>
                                    <xs:attribute name="duration" type="g_time">
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="fishingLine" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="collisionGroup" type="g_uint" default="262144">
                                        <xs:annotation><xs:documentation xml:lang="en">collisionGroup of the rope</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="collisionMask" type="g_uint" default="342274">
