                </xs:element>
                <xs:element name="tethered" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:attribute name="actionRange" type="g_float">
                            <xs:annotation><xs:documentation xml:lang="en">The range in metres in which this tool can work. When outside of this range, the range warning is shown</xs:documentation><xs:appinfo><defaultStr>3 metres</defaultStr></xs:appinfo></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="range" type="g_float">
                            <xs:annotation><xs:documentation xml:lang="en">The range in metres before this tool snaps back into its holder</xs:documentation><xs:appinfo><defaultStr>5 metres</defaultStr></xs:appinfo></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="warningText" type="g_l10n_string">
                            <xs:annotation><xs:documentation xml:lang="en">The l10n text string to use when warning the player of the range. The remaining range is the first argument</xs:documentation></xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
            </xs:all>
            <xs:attribute name="type" type="g_string" use="required">
                <xs:annotation>
                    <xs:documentation xml:lang="en">The specialisation type of the hand tool</xs:documentation>
                    <xs:appinfo>
                        <typeStr>String</typeStr>
                        <giantsAutoCompletion sourceFile="$dataS/handToolTypes.xml" prefix="">
                            <path>handToolTypes.type#name</path>
                        </giantsAutoCompletion>
                    </xs:appinfo>
                </xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
</xs:schema>
