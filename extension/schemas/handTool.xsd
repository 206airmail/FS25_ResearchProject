            </xs:element>
            <xs:element name="spikes" minOccurs="0" maxOccurs="1">
                <xs:complexType>
                    <xs:choice maxOccurs="unbounded">
                        <xs:element name="spike" minOccurs="0" maxOccurs="unbounded">
                            <xs:complexType>
                                <xs:attribute name="node" type="g_node_index">
                                    <xs:annotation><xs:documentation xml:lang="en">(RotationAnimationSpikes) Spike node</xs:documentation></xs:annotation>
                                </xs:attribute>
                            </xs:complexType>
                        </xs:element>
                    </xs:choice>
                    <xs:attribute name="gravityFactor" type="g_float">
                        <xs:annotation><xs:documentation xml:lang="en">(RotationAnimationSpikesGravity) Factor to adjust how fast the spike adjusts and falls down</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="inverted" type="g_bool" default="false">
                        <xs:annotation><xs:documentation xml:lang="en">(RotationAnimationSpikes) Min. and max. rotation/translation of spikes are inverted</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="maxRot" type="g_angle">
                        <xs:annotation><xs:documentation xml:lang="en">(RotationAnimationSpikes) Max. spike rotation</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="maxTrans" type="g_float">
                        <xs:annotation><xs:documentation xml:lang="en">(RotationAnimationSpikes) Max. spike translation</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="minRot" type="g_angle">
                        <xs:annotation><xs:documentation xml:lang="en">(RotationAnimationSpikes) Min. spike rotation</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="moveDownRange" type="g_vector_rot_2">
                        <xs:annotation><xs:documentation xml:lang="en">(RotationAnimationSpikes) Move down range</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="moveUpRange" type="g_vector_rot_2">
                        <xs:annotation><xs:documentation xml:lang="en">(RotationAnimationSpikes) Move up range</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="rotAxis" type="g_int" default="3">
                        <xs:annotation><xs:documentation xml:lang="en">(RotationAnimationSpikes) Rotation axis</xs:documentation></xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="transAxis" type="g_int" default="3">
                        <xs:annotation><xs:documentation xml:lang="en">(RotationAnimationSpikes) Translation axis (disables the rotation adjustment of the spike)</xs:documentation></xs:annotation>
                    </xs:attribute>
                </xs:complexType>
            </xs:element>
        </xs:choice>
        <xs:attribute name="class" type="g_string" default="RotationAnimation">
            <xs:annotation><xs:documentation xml:lang="en">Animation class (RotationAnimation | RotationAnimationSpikes | RotationAnimationSpikesGravity | ScrollingAnimation | ShakeAnimation)</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="minAlphaForTurnOff" type="g_float" default="0">
            <xs:annotation><xs:documentation xml:lang="en">Min. alpha for turn off (speed [0-1])</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="node" type="g_node_index">
            <xs:annotation><xs:documentation xml:lang="en">Node</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="rotAxis" type="g_float" default="2">
            <xs:annotation><xs:documentation xml:lang="en">Rotation axis</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="rotSpeed" type="g_angle" default="1">
            <xs:annotation><xs:documentation xml:lang="en">Rotation speed</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="scrollLength" type="g_float" default="1">
            <xs:annotation><xs:documentation xml:lang="en">(ScrollingAnimation) Scroll length</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="scrollSpeed" type="g_float" default="1">
            <xs:annotation><xs:documentation xml:lang="en">(ScrollingAnimation) Scroll speed</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="shaderComponentScale" type="g_vector_4" default="1 0 0 0">
            <xs:annotation><xs:documentation xml:lang="en">Shader parameter name</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="shaderParameterComponent" type="g_float" default="1">
            <xs:annotation><xs:documentation xml:lang="en">(ScrollingAnimation) Shader parameter component</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="shaderParameterName" type="g_string">
            <xs:annotation><xs:documentation xml:lang="en">Shader parameter name</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="shaderParameterPrevName" type="g_string" default="automatically calculated from #shaderParameterName">
            <xs:annotation><xs:documentation xml:lang="en">Prev Shader parameter name</xs:documentation></xs:annotation>
        </xs:attribute>
        <xs:attribute name="shaking" type="g_vector_4" default="0 0 0 0">
