    <xs:element name="templates">
        <xs:complexType>
            <xs:choice maxOccurs="unbounded">
                <xs:element name="parentFile" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:all>
                            <xs:element name="attributes" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:choice maxOccurs="unbounded">
                                        <xs:element name="clearList" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="keepIndex" type="g_int">
                                                    <xs:annotation><xs:documentation xml:lang="en">Index of list to keep</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="path" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">List to clear but keep one item</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="remove" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="path" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Path to remove from parent xml</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="set" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="path" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Path change in parent xml</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="value" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Target value to set in parent file</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:choice>
                                </xs:complexType>
                            </xs:element>
                        </xs:all>
                        <xs:attribute name="xmlFilename" type="g_string">
                            <xs:annotation><xs:documentation xml:lang="en">Parent xml filepath used as basis</xs:documentation></xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="template" minOccurs="0" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:all>
                            <xs:element name="colorScan" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="channelB" type="g_bool" default="true">
                                        <xs:annotation><xs:documentation xml:lang="en">Calibrate blue channel</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="channelG" type="g_bool" default="true">
                                        <xs:annotation><xs:documentation xml:lang="en">Calibrate green channel</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="channelMetalness" type="g_bool" default="true">
                                        <xs:annotation><xs:documentation xml:lang="en">Calibrate metalness</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="channelR" type="g_bool" default="true">
                                        <xs:annotation><xs:documentation xml:lang="en">Calibrate red channel</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="channelSmoothness" type="g_bool" default="true">
                                        <xs:annotation><xs:documentation xml:lang="en">Calibrate smoothness</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="filename" type="g_string">
                                        <xs:annotation><xs:documentation xml:lang="en">Path to scan reference</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:all>
                        <xs:attribute name="brand" type="fs25_brand">
                            <xs:annotation><xs:documentation xml:lang="en">Brand identifier</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="category" type="fs25_storeCategory">
                            <xs:annotation><xs:documentation xml:lang="en">Category name (Used by DCC Tool)</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="clearCoatIntensity" type="g_float">
                        </xs:attribute>
                        <xs:attribute name="clearCoatSmoothness" type="g_float">
                        </xs:attribute>
                        <xs:attribute name="colorScale" type="g_vector_3">
                            <xs:annotation><xs:documentation xml:lang="en">Color values (sRGB)</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="description" type="g_string">
                            <xs:annotation><xs:documentation xml:lang="en">Descrpition text of the template</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="detailDiffuse" type="g_string">
                            <xs:annotation><xs:documentation xml:lang="en">Detail diffuse texture</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="detailNormal" type="g_string">
                            <xs:annotation><xs:documentation xml:lang="en">Detail normal texture</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="detailSpecular" type="g_string">
                            <xs:annotation><xs:documentation xml:lang="en">Detail specular texture</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="iconFilename" type="g_string">
                            <xs:annotation><xs:documentation xml:lang="en">Icon filename (Used by DCC Tool)</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="metalnessScale" type="g_float">
                        </xs:attribute>
                        <xs:attribute name="name" type="g_string">
                            <xs:annotation><xs:documentation xml:lang="en">Name of template</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="parentTemplate" type="g_string" default="templates#parentTemplateDefault">
                            <xs:annotation><xs:documentation xml:lang="en">Name of parent template</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="porosity" type="g_float">
                        </xs:attribute>
                        <xs:attribute name="smoothnessScale" type="g_float">
                        </xs:attribute>
                        <xs:attribute name="title" type="g_string">
                            <xs:annotation><xs:documentation xml:lang="en">Name of the color to display in the shop</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="usage" type="g_int">
                            <xs:annotation><xs:documentation xml:lang="en">Usage of the color</xs:documentation></xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
            </xs:choice>
            <xs:attribute name="id" type="g_string">
                <xs:annotation><xs:documentation xml:lang="en">File Identifier</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="name" type="g_string">
                <xs:annotation><xs:documentation xml:lang="en">File Name</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="parentTemplateDefault" type="g_string">
                <xs:annotation><xs:documentation xml:lang="en">Name of default parent template</xs:documentation></xs:annotation>
            </xs:attribute>
            <xs:attribute name="parentTemplateFilename" type="g_string">
                <xs:annotation><xs:documentation xml:lang="en">Path to parent template file</xs:documentation></xs:annotation>
            </xs:attribute>
        </xs:complexType>
    </xs:element>
</xs:schema>
