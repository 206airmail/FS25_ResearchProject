                                    <xs:attribute name="widthAndDiam" type="g_vector_2">
                                        <xs:annotation><xs:documentation xml:lang="en">Tire - Width and diameter</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="wheelChock" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:all>
                                        <xs:element name="clearCoat" minOccurs="0" maxOccurs="1">
                                            <xs:complexType>
                                                <xs:attribute name="intensity" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">Intensity of clear coat</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="smoothness" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">Smoothness of clear coat</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="colorScale" minOccurs="0" maxOccurs="1">
                                            <xs:complexType>
                                                <xs:attribute name="value" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Material color if it should not be used from configuration (can also be a different material template, from which then ONLY the color is taken)</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="detail" minOccurs="0" maxOccurs="1">
                                            <xs:complexType>
                                                <xs:attribute name="diffuse" type="g_filename">
                                                    <xs:annotation><xs:documentation xml:lang="en">Path to detail diffuse texture</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="normal" type="g_filename">
                                                    <xs:annotation><xs:documentation xml:lang="en">Path to detail normal texture</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="specular" type="g_filename">
                                                    <xs:annotation><xs:documentation xml:lang="en">Path to detail specular texture</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="metalness" minOccurs="0" maxOccurs="1">
                                            <xs:complexType>
                                                <xs:attribute name="value" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">Metalness value</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="smoothness" minOccurs="0" maxOccurs="1">
                                            <xs:complexType>
                                                <xs:attribute name="value" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">Smoothness value</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="textures" minOccurs="0" maxOccurs="1">
                                            <xs:complexType>
                                                <xs:attribute name="diffuse" type="g_filename">
                                                    <xs:annotation><xs:documentation xml:lang="en">Path to diffuse texture</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="normal" type="g_filename">
                                                    <xs:annotation><xs:documentation xml:lang="en">Path to normal texture</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="specular" type="g_filename">
                                                    <xs:annotation><xs:documentation xml:lang="en">Path to specular texture</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:all>
                                    <xs:attribute name="filename" type="g_string" default="$data/shared/assets/wheelChocks/wheelChock01.i3d">
                                        <xs:annotation><xs:documentation xml:lang="en">Path to wheel chock i3d</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="isInverted" type="g_bool" default="false">
                                        <xs:annotation><xs:documentation xml:lang="en">Is inverted (In front or back of the wheel)</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="isParked" type="g_bool" default="false">
                                        <xs:annotation><xs:documentation xml:lang="en">Default is parked</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="materialSlotName" type="g_string">
                                        <xs:annotation><xs:documentation xml:lang="en">Material slot name in the i3d file</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="materialTemplateName" type="g_string">
                                        <xs:annotation>
                                            <xs:documentation xml:lang="en">Name of template to apply (all attributes will be used from template)</xs:documentation>
                                            <xs:appinfo>
                                                <typeStr>String</typeStr>
                                                <giantsAutoCompletion sourceFile="$data/shared/brandMaterialTemplates.xml" prefix="">
                                                    <path>templates.template#name</path>
                                                </giantsAutoCompletion>
                                            </xs:appinfo>
                                        </xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="materialTemplateUseColorOnly" type="g_bool" default="false">
                                        <xs:annotation><xs:documentation xml:lang="en">If &apos;true&apos;, only the color is used from the material template. The rest from the i3d file.</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="offset" type="g_vector_trans" default="0 0 0">
                                        <xs:annotation><xs:documentation xml:lang="en">Translation offset</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="parkingNode" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">Parking node</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="scale" type="g_vector_scale" default="1 1 1">
                                        <xs:annotation><xs:documentation xml:lang="en">Scale</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                            <xs:element name="wheelParticleSystem" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:attribute name="direction" type="g_int" default="0">
