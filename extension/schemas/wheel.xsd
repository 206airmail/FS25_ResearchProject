                                    <xs:attribute name="maxSpeed" type="g_float" default="20">
                                        <xs:annotation><xs:documentation xml:lang="en">Max. speed for activation</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="minScale" type="g_float" default="0.1">
                                        <xs:annotation><xs:documentation xml:lang="en">Min. scale</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="minSpeed" type="g_float" default="3">
                                        <xs:annotation><xs:documentation xml:lang="en">Min. speed for activation</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="onlyActiveOnGroundContact" type="g_bool" default="true">
                                        <xs:annotation><xs:documentation xml:lang="en">Only active while wheel has ground contact</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="psOffset" type="g_vector_trans" default="0 0 0">
                                        <xs:annotation><xs:documentation xml:lang="en">Translation offset</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:choice>
                        <xs:attribute name="additionalMaterial" type="g_int">
                            <xs:annotation><xs:documentation xml:lang="en">Additional wheel material id</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="configId" type="g_string" default="default">
                            <xs:annotation><xs:documentation xml:lang="en">Wheel config id</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="dimensions" type="g_string">
                            <xs:annotation><xs:documentation xml:lang="en">List of dimensions for automatic branded wheel configuration generation</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="filename" type="g_string">
                            <xs:annotation>
                                <xs:documentation xml:lang="en">Filename</xs:documentation>
                                <xs:appinfo>
                                    <typeStr>String</typeStr>
                                    <giantsAutoCompletion sourceFile="$data/shared/wheels/wheels.xml" prefix="">
                                        <path>wheels.wheel#filename</path>
                                    </giantsAutoCompletion>
                                </xs:appinfo>
                            </xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="hasParticles" type="g_bool" default="false">
                            <xs:annotation><xs:documentation xml:lang="en">Has particles</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="hasTireTracks" type="g_bool" default="false">
                            <xs:annotation><xs:documentation xml:lang="en">Has tire tracks</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="hasWaterParticles" type="g_bool">
                            <xs:annotation><xs:documentation xml:lang="en">Has water particles</xs:documentation><xs:appinfo><defaultStr>true if visual wheel is defined</defaultStr></xs:appinfo></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="isCareWheel" type="g_bool" default="false">
                            <xs:annotation><xs:documentation xml:lang="en">Is care wheel</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="isLeft" type="g_bool" default="true">
                            <xs:annotation><xs:documentation xml:lang="en">Is left</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="isShallowWaterObstacle" type="g_bool" default="true">
                            <xs:annotation><xs:documentation xml:lang="en">The visual wheels will interact with the shallow water simulation</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="material" type="g_int">
                            <xs:annotation><xs:documentation xml:lang="en">Wheel material id</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="rimMaterialTemplateName" type="fs25_materialTemplate">
                            <xs:annotation><xs:documentation xml:lang="en">Material template to apply to the inner and outer rim</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="rimOffset" type="g_float" default="0">
                            <xs:annotation><xs:documentation xml:lang="en">Offset that is only applied to the outer rim and the wheel itself, inner rim stays the same.</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="waterParticleDirection" type="g_int" default="0">
                            <xs:annotation><xs:documentation xml:lang="en">The direction in which the water particles should only be active (0: both, 1: only the front, -1: only the back)</xs:documentation></xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="metadata" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:attribute name="allowMixture" type="g_bool" default="false">
                            <xs:annotation><xs:documentation xml:lang="en">Allow mixing with other tires from the same brand</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="brand" type="fs25_brand" default="LIZARD">
                            <xs:annotation>
                                <xs:documentation xml:lang="en">Wheel tire brand</xs:documentation>
                                <xs:appinfo>
                                    <typeStr>String</typeStr>
                                    <giantsAutoCompletion sourceFile="$dataS/brands.xml" prefix="">
                                        <path>brands.brand#name</path>
                                    </giantsAutoCompletion>
                                </xs:appinfo>
                            </xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="category" type="fs25_storeCategory">
                            <xs:annotation><xs:documentation xml:lang="en">Wheel tire category for automatic wheel configurations</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="name" type="g_string" default="Tire">
                            <xs:annotation><xs:documentation xml:lang="en">Wheel tire name</xs:documentation></xs:annotation>
                        </xs:attribute>
                        <xs:attribute name="priority" type="g_float" default="1">
                            <xs:annotation><xs:documentation xml:lang="en">Tire priority for selection in the shop (wheels with high prio will be shown first)</xs:documentation></xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="parentFile" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:all>
                            <xs:element name="attributes" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:choice maxOccurs="unbounded">
                                        <xs:element name="clearList" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="keepIndex" type="g_int">
                                                    <xs:annotation><xs:documentation xml:lang="en">Index of list to keep</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="path" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">List to clear but keep one item</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="remove" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="path" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Path to remove from parent xml</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="set" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="path" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Path change in parent xml</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="value" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Target value to set in parent file</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:choice>
                                </xs:complexType>
                            </xs:element>
                        </xs:all>
                        <xs:attribute name="xmlFilename" type="g_string">
                            <xs:annotation><xs:documentation xml:lang="en">Parent xml filepath used as basis</xs:documentation></xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
            </xs:all>
        </xs:complexType>
    </xs:element>
</xs:schema>
