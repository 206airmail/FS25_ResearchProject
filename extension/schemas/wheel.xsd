                                                                        <xs:attribute name="normal" type="g_filename">
                                                                            <xs:annotation><xs:documentation xml:lang="en">Path to detail normal texture</xs:documentation></xs:annotation>
                                                                        </xs:attribute>
                                                                        <xs:attribute name="specular" type="g_filename">
                                                                            <xs:annotation><xs:documentation xml:lang="en">Path to detail specular texture</xs:documentation></xs:annotation>
                                                                        </xs:attribute>
                                                                    </xs:complexType>
                                                                </xs:element>
                                                                <xs:element name="metalness" minOccurs="0" maxOccurs="1">
