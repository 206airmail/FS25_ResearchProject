        <xs:restriction base="xs:float"/>
    </xs:simpleType>

    <xs:simpleType name="g_day_time">
        <xs:annotation><xs:appinfo><typeStr>Time hh:mm:ss.sss format</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:time"/>
    </xs:simpleType>

    <xs:simpleType name="g_int">
        <xs:annotation><xs:appinfo><typeStr>Integer</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:integer"/>
    </xs:simpleType>

    <xs:simpleType name="g_uint">
        <xs:annotation><xs:appinfo><typeStr>Integer (unsigned)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:integer"/>
    </xs:simpleType>

    <xs:simpleType name="g_bool">
        <xs:annotation><xs:appinfo><typeStr>Boolean</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="true|false"/>
            <xs:whiteSpace value="preserve"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_node_index">
        <xs:annotation><xs:appinfo><typeStr>Index to i3d node or i3d mapping identifier</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

    <xs:simpleType name="g_node_indices">
        <xs:annotation><xs:appinfo><typeStr>List of indices to i3d nodes or i3d mapping identifiers</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

    <xs:simpleType name="g_vector_2">
        <xs:annotation><xs:appinfo><typeStr>Multiple values (x, y)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float">
            <xs:pattern value="\S+ \S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_vector_3">
        <xs:annotation><xs:appinfo><typeStr>Multiple values (x, y, z)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float">
            <xs:pattern value="\S+ \S+ \S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_vector_4">
        <xs:annotation><xs:appinfo><typeStr>Multiple values (x, y, z, w)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float">
            <xs:pattern value="\S+ \S+ \S+ \S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_vector_n">
        <xs:annotation><xs:appinfo><typeStr>Multiple values</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float"/>
    </xs:simpleType>

    <xs:simpleType name="g_vector_trans">
        <xs:annotation><xs:appinfo><typeStr>Translation values (x, y, z)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float">
            <xs:pattern value="\S+ \S+ \S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_vector_rot">
        <xs:annotation><xs:appinfo><typeStr>Rotation values (x, y, z)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float">
            <xs:pattern value="\S+ \S+ \S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_vector_rot_2">
        <xs:annotation><xs:appinfo><typeStr>Rotation values (x, y)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float">
            <xs:pattern value="\S+ \S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_vector_scale">
        <xs:annotation><xs:appinfo><typeStr>Scale values (x, y, z)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float">
            <xs:pattern value="\S+ \S+ \S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_color">
        <xs:annotation><xs:appinfo><typeStr>Color values (r, g, b) or brand color id</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

    <xs:simpleType name="g_vehicle_material">
        <xs:annotation><xs:appinfo><typeStr>Name of brand material template or color values (r,g,b)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

    <xs:element name="player">
        <xs:complexType>
            <xs:all>
                <xs:element name="animation" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:attribute name="filename" type="g_string" use="required">
                            <xs:annotation><xs:documentation xml:lang="en">The path of the xml file for the animation</xs:documentation></xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
                <xs:element name="filename" type="g_string" minOccurs="1">
                    <xs:annotation><xs:documentation xml:lang="en">The file path of the player&apos;s i3d file</xs:documentation></xs:annotation>
                </xs:element>
                <xs:element name="i3dMappings" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:choice maxOccurs="unbounded">
                            <xs:element name="i3dMapping" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:attribute name="id" type="g_string">
                                        <xs:annotation><xs:documentation xml:lang="en">Identifier to be used in xml</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="node" type="g_string">
                                        <xs:annotation><xs:documentation xml:lang="en">Index path to node in i3d file</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:choice>
                    </xs:complexType>
                </xs:element>
                <xs:element name="ikChains" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:choice maxOccurs="unbounded">
                            <xs:element name="ikChain" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:choice maxOccurs="unbounded">
                                        <xs:element name="node" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="damping" type="g_angle" default="30">
                                                    <xs:annotation><xs:documentation xml:lang="en">Damping</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="index" type="g_node_index">
                                                    <xs:annotation><xs:documentation xml:lang="en">Chain node</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="localLimits" type="g_bool" default="false">
                                                    <xs:annotation><xs:documentation xml:lang="en">Local limits</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxRx" type="g_angle" default="180">
                                                    <xs:annotation><xs:documentation xml:lang="en">Max. rotation X</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxRy" type="g_angle" default="180">
                                                    <xs:annotation><xs:documentation xml:lang="en">Max. rotation Y</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="maxRz" type="g_angle" default="180">
                                                    <xs:annotation><xs:documentation xml:lang="en">Max. rotation Z</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="minRx" type="g_angle" default="-180">
                                                    <xs:annotation><xs:documentation xml:lang="en">Min. rotation X</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="minRy" type="g_angle" default="-180">
                                                    <xs:annotation><xs:documentation xml:lang="en">Min. rotation Y</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="minRz" type="g_angle" default="-180">
                                                    <xs:annotation><xs:documentation xml:lang="en">Min. rotation Z</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="pose" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:choice maxOccurs="unbounded">
                                                    <xs:element name="rotationNode" minOccurs="0" maxOccurs="unbounded">
                                                        <xs:complexType>
                                                            <xs:attribute name="index" type="g_node_index">
                                                                <xs:annotation><xs:documentation xml:lang="en">Rotation node</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="rotation" type="g_vector_rot">
                                                                <xs:annotation><xs:documentation xml:lang="en">Rotation</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:choice>
                                                <xs:attribute name="id" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Pose id</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="isDefaultPose" type="g_bool" default="false">
                                                    <xs:annotation><xs:documentation xml:lang="en">Is default pose</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="rotationNode" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="index" type="g_node_index">
                                                    <xs:annotation><xs:documentation xml:lang="en">Rotation node</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="rotation" type="g_vector_rot">
                                                    <xs:annotation><xs:documentation xml:lang="en">Rotation</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:choice>
                                    <xs:attribute name="alignToTarget" type="g_bool" default="false">
                                        <xs:annotation><xs:documentation xml:lang="en">Align to target</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="id" type="g_string">
                                        <xs:annotation><xs:documentation xml:lang="en">Chain identifier</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="isDirtyOnLoad" type="g_bool" default="false">
                                        <xs:annotation><xs:documentation xml:lang="en">Is dirty on load</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="numIterations" type="g_int" default="20">
                                        <xs:annotation><xs:documentation xml:lang="en">Max. number of iterations</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="numIterationsInit" type="g_int">
                                        <xs:annotation><xs:documentation xml:lang="en">Initial max. number of iterations</xs:documentation><xs:appinfo><defaultStr>numIterations * 2</defaultStr></xs:appinfo></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="positionThreshold" type="g_float" default="0.005">
                                        <xs:annotation><xs:documentation xml:lang="en">Position threshold</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="target" type="g_node_index">
                                        <xs:annotation><xs:documentation xml:lang="en">Target node</xs:documentation></xs:annotation>
