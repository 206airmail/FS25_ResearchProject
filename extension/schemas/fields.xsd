<?xml version="1.0" encoding="UTF-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:simpleType name="g_vector_float">
        <xs:list itemType="xs:float"/>
    </xs:simpleType>

    <xs:simpleType name="g_string">
        <xs:annotation><xs:appinfo><typeStr>String</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

    <xs:simpleType name="g_string_list">
        <xs:annotation><xs:appinfo><typeStr>One or more strings separated by a single whitespace</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="\S+( \S+)*"/>
            <xs:whiteSpace value="preserve"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_l10n_string">
        <xs:annotation><xs:appinfo><typeStr>String or l10n key</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

    <xs:simpleType name="g_filename">
        <xs:annotation><xs:appinfo><typeStr>Path to a certain file</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

    <xs:simpleType name="g_float">
        <xs:annotation><xs:appinfo><typeStr>Float</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:float"/>
    </xs:simpleType>

    <xs:simpleType name="g_angle">
        <xs:annotation><xs:appinfo><typeStr>Angle</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:float"/>
    </xs:simpleType>

    <xs:simpleType name="g_time">
        <xs:annotation><xs:appinfo><typeStr>Time in seconds</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:float"/>
    </xs:simpleType>

    <xs:simpleType name="g_day_time">
        <xs:annotation><xs:appinfo><typeStr>Time hh:mm:ss.sss format</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:time"/>
    </xs:simpleType>

    <xs:simpleType name="g_int">
        <xs:annotation><xs:appinfo><typeStr>Integer</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:integer"/>
    </xs:simpleType>

    <xs:simpleType name="g_uint">
        <xs:annotation><xs:appinfo><typeStr>Integer (unsigned)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:integer"/>
    </xs:simpleType>

    <xs:simpleType name="g_bool">
        <xs:annotation><xs:appinfo><typeStr>Boolean</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="true|false"/>
            <xs:whiteSpace value="preserve"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_node_index">
        <xs:annotation><xs:appinfo><typeStr>Index to i3d node or i3d mapping identifier</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

    <xs:simpleType name="g_node_indices">
        <xs:annotation><xs:appinfo><typeStr>List of indices to i3d nodes or i3d mapping identifiers</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

    <xs:simpleType name="g_vector_2">
        <xs:annotation><xs:appinfo><typeStr>Multiple values (x, y)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float">
            <xs:pattern value="\S+ \S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_vector_3">
        <xs:annotation><xs:appinfo><typeStr>Multiple values (x, y, z)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float">
            <xs:pattern value="\S+ \S+ \S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_vector_4">
        <xs:annotation><xs:appinfo><typeStr>Multiple values (x, y, z, w)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float">
            <xs:pattern value="\S+ \S+ \S+ \S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_vector_n">
        <xs:annotation><xs:appinfo><typeStr>Multiple values</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float"/>
    </xs:simpleType>

    <xs:simpleType name="g_vector_trans">
        <xs:annotation><xs:appinfo><typeStr>Translation values (x, y, z)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float">
            <xs:pattern value="\S+ \S+ \S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_vector_rot">
        <xs:annotation><xs:appinfo><typeStr>Rotation values (x, y, z)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float">
            <xs:pattern value="\S+ \S+ \S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_vector_rot_2">
        <xs:annotation><xs:appinfo><typeStr>Rotation values (x, y)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float">
            <xs:pattern value="\S+ \S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_vector_scale">
        <xs:annotation><xs:appinfo><typeStr>Scale values (x, y, z)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="g_vector_float">
            <xs:pattern value="\S+ \S+ \S+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="g_color">
        <xs:annotation><xs:appinfo><typeStr>Color values (r, g, b) or brand color id</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

    <xs:simpleType name="g_vehicle_material">
        <xs:annotation><xs:appinfo><typeStr>Name of brand material template or color values (r,g,b)</typeStr></xs:appinfo></xs:annotation>
        <xs:restriction base="xs:string"/>
    </xs:simpleType>

    <xs:element name="map">
        <xs:complexType>
            <xs:all>
                <xs:element name="fields" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:choice maxOccurs="unbounded">
                            <xs:element name="field" minOccurs="0" maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:all>
                                        <xs:element name="area" minOccurs="0" maxOccurs="1">
                                            <xs:complexType>
                                                <xs:all>
                                                    <xs:element name="circle" minOccurs="0" maxOccurs="1">
                                                        <xs:complexType>
                                                            <xs:attribute name="numSegments" type="g_int" default="5">
                                                                <xs:annotation><xs:documentation xml:lang="en">Number of circle segments</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="radius" type="g_float" default="5">
                                                                <xs:annotation><xs:documentation xml:lang="en">Circle radius</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="worldPositionXZ" type="g_vector_2">
                                                                <xs:annotation><xs:documentation xml:lang="en">Circle center world position (x,z)</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                        </xs:complexType>
                                                    </xs:element>
                                                    <xs:element name="parallelogram" minOccurs="0" maxOccurs="1">
                                                        <xs:complexType>
                                                            <xs:attribute name="heightXZ" type="g_vector_2">
                                                                <xs:annotation><xs:documentation xml:lang="en">Parallelogram world height size (x,z)</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="widthXZ" type="g_vector_2">
                                                                <xs:annotation><xs:documentation xml:lang="en">Parallelogram world width size (x,z)</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="worldHeightXZ" type="g_vector_2">
                                                                <xs:annotation><xs:documentation xml:lang="en">Parallelogram world height position (x,z)</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="worldStartXZ" type="g_vector_2">
                                                                <xs:annotation><xs:documentation xml:lang="en">Parallelogram world start position (x,z)</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                            <xs:attribute name="worldWidthXZ" type="g_vector_2">
                                                                <xs:annotation><xs:documentation xml:lang="en">Parallelogram world width position (x,z)</xs:documentation></xs:annotation>
                                                            </xs:attribute>
                                                        </xs:complexType>
                                                    </xs:element>
                                                    <xs:element name="polygon" minOccurs="0" maxOccurs="1">
                                                        <xs:complexType>
                                                            <xs:choice maxOccurs="unbounded">
                                                                <xs:element name="point" type="g_vector_2" minOccurs="0">
                                                                    <xs:annotation><xs:documentation xml:lang="en">Polygon point world position (x,z)</xs:documentation></xs:annotation>
                                                                </xs:element>
                                                            </xs:choice>
                                                        </xs:complexType>
                                                    </xs:element>
                                                </xs:all>
                                                <xs:attribute name="currentMaxY" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">Current polygon minY clip region</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="currentMinY" type="g_float">
                                                    <xs:annotation><xs:documentation xml:lang="en">Current polygon minY clip region</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="fruit" minOccurs="0" maxOccurs="1">
                                            <xs:complexType>
                                                <xs:attribute name="growthState" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Growthstate of the fruit type</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="type" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Name of the fruit type</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="ground" minOccurs="0" maxOccurs="1">
                                            <xs:complexType>
                                                <xs:attribute name="angle" type="g_int">
                                                    <xs:annotation><xs:documentation xml:lang="en">Angle of the ground</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="type">
                                                    <xs:simpleType>
                                                        <xs:annotation><xs:documentation xml:lang="en">Name of the ground type</xs:documentation></xs:annotation>
                                                        <xs:restriction base="xs:string">
                                                            <xs:enumeration value="CULTIVATED" />
                                                            <xs:enumeration value="DIRECT_SOWN" />
                                                            <xs:enumeration value="GRASS" />
                                                            <xs:enumeration value="GRASS_CUT" />
                                                            <xs:enumeration value="HARVEST_READY" />
                                                            <xs:enumeration value="HARVEST_READY_OTHER" />
                                                            <xs:enumeration value="NONE" />
                                                            <xs:enumeration value="PLANTED" />
                                                            <xs:enumeration value="PLOWED" />
                                                            <xs:enumeration value="RIDGE" />
                                                            <xs:enumeration value="RIDGE_SOWN" />
                                                            <xs:enumeration value="ROLLED_SEEDBED" />
                                                            <xs:enumeration value="ROLLER_LINES" />
                                                            <xs:enumeration value="SEEDBED" />
                                                            <xs:enumeration value="SOWN" />
                                                            <xs:enumeration value="STUBBLE_TILLAGE" />
                                                        </xs:restriction>
                                                    </xs:simpleType>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="spray" minOccurs="0" maxOccurs="1">
                                            <xs:complexType>
                                                <xs:attribute name="level" type="g_int">
                                                    <xs:annotation><xs:documentation xml:lang="en">Level of the spray</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="type">
                                                    <xs:simpleType>
                                                        <xs:annotation><xs:documentation xml:lang="en">Name of the spray type</xs:documentation></xs:annotation>
                                                        <xs:restriction base="xs:string">
                                                            <xs:enumeration value="FERTILIZER" />
                                                            <xs:enumeration value="LIME" />
                                                            <xs:enumeration value="LIQUID_MANURE" />
                                                            <xs:enumeration value="MANURE" />
                                                            <xs:enumeration value="NONE" />
                                                        </xs:restriction>
                                                    </xs:simpleType>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:all>
                                    <xs:attribute name="className" type="g_string">
                                    </xs:attribute>
                                    <xs:attribute name="clearHeight" type="g_bool">
                                        <xs:annotation><xs:documentation xml:lang="en">Clear tip anything</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="customName" type="g_string">
                                        <xs:annotation><xs:documentation xml:lang="en">Custom name of the task</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="fieldId" type="g_int">
                                        <xs:annotation><xs:documentation xml:lang="en">Id of the field</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="fieldType">
                                        <xs:simpleType>
                                            <xs:annotation><xs:documentation xml:lang="en">Name of the field type</xs:documentation></xs:annotation>
                                            <xs:restriction base="xs:string">
                                                <xs:enumeration value="DEFAULT" />
                                                <xs:enumeration value="RICE" />
                                            </xs:restriction>
                                        </xs:simpleType>
                                    </xs:attribute>
                                    <xs:attribute name="limeLevel" type="g_int">
                                        <xs:annotation><xs:documentation xml:lang="en">Lime level</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="plowLevel" type="g_int">
                                        <xs:annotation><xs:documentation xml:lang="en">Plow level</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="rollerLevel" type="g_int">
                                        <xs:annotation><xs:documentation xml:lang="en">Roller level</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="status" type="g_string">
                                        <xs:annotation><xs:documentation xml:lang="en">Status of the task</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="stoneLevel" type="g_int">
                                        <xs:annotation><xs:documentation xml:lang="en">Stone level</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="stubbleShredLevel" type="g_int">
                                        <xs:annotation><xs:documentation xml:lang="en">Stubbleshred level</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                    <xs:attribute name="weedState" type="g_int">
                                        <xs:annotation><xs:documentation xml:lang="en">Weed state</xs:documentation></xs:annotation>
                                    </xs:attribute>
                                </xs:complexType>
                            </xs:element>
                        </xs:choice>
                    </xs:complexType>
                </xs:element>
                <xs:element name="parentFile" minOccurs="0" maxOccurs="1">
                    <xs:complexType>
                        <xs:all>
                            <xs:element name="attributes" minOccurs="0" maxOccurs="1">
                                <xs:complexType>
                                    <xs:choice maxOccurs="unbounded">
                                        <xs:element name="clearList" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="keepIndex" type="g_int">
                                                    <xs:annotation><xs:documentation xml:lang="en">Index of list to keep</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="path" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">List to clear but keep one item</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="remove" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="path" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Path to remove from parent xml</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                        <xs:element name="set" minOccurs="0" maxOccurs="unbounded">
                                            <xs:complexType>
                                                <xs:attribute name="path" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Path change in parent xml</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                                <xs:attribute name="value" type="g_string">
                                                    <xs:annotation><xs:documentation xml:lang="en">Target value to set in parent file</xs:documentation></xs:annotation>
                                                </xs:attribute>
                                            </xs:complexType>
                                        </xs:element>
                                    </xs:choice>
                                </xs:complexType>
                            </xs:element>
                        </xs:all>
                        <xs:attribute name="xmlFilename" type="g_string">
                            <xs:annotation><xs:documentation xml:lang="en">Parent xml filepath used as basis</xs:documentation></xs:annotation>
                        </xs:attribute>
                    </xs:complexType>
                </xs:element>
            </xs:all>
        </xs:complexType>
    </xs:element>
</xs:schema>
